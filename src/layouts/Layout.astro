---
/**
 * 基础布局 - 所有页面继承这个
 * @prop {string} title - 页面标题
 * @prop {string} description - 页面描述
 * @prop {string} image - OG 图片
 * @prop {'zh' | 'en'} lang - 语言
 * @prop {string} canonical - 规范 URL
 */
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import AdSlot from '@components/AdSlot.astro';
import { SITE } from '@/config';
import { getLangFromUrl, hreflangsFor } from '@i18n/utils';
import faviconUrl from '/favicon.svg?url';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'zh' | 'en';
  canonical?: string;
  schema?: Record<string, any>;
  showTopAd?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultImage,
  lang,
  canonical,
  schema,
  showTopAd = true,
} = Astro.props;

// 推断 lang：如果 prop 没传，从 URL 推断
const finalLang: 'zh' | 'en' = lang || getLangFromUrl(Astro.url);
const ogLocale = finalLang === 'zh' ? 'zh_CN' : 'en_US';
const htmlLang = finalLang === 'zh' ? 'zh-CN' : 'en';

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image, Astro.site).href;
const rssUrl = new URL('rss.xml', Astro.site).href;
const hreflangs = hreflangsFor(Astro.url.pathname);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="2hRMJPHytmhSma8SEv1fTUOpq8Msl5vktP0oDp_mxP8" />

    {/* Plausible Analytics - 隐私友好，不影响 AdSense */}
    <script defer data-domain="palworldpedia.cc" src="https://plausible.io/js/script.js"></script>

    {/* Google AdSense */}
    {SITE.adsense.enabled && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense.client}`}
        crossorigin="anonymous"
      />
    )}

    {/* hreflang - 中英双语 */}
    {hreflangs.map(({ lang: hl, href }) => (
      <link rel="alternate" hreflang={hl} href={href.startsWith('http') ? href : new URL(href, Astro.site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/en(\/|$)/, '/') || '/', Astro.site).href} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Favicon - 多格式兼容各种场景（含 Google 搜索结果）*/}
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/* PWA */}
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Palworldpedia" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/favicon-512.png" />

    {/* 主题色 */}
    <meta name="theme-color" content="#0f1419" />

    {/* 结构化数据 */}
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    {/* RSS */}
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={rssUrl} />

    {/* === 浏览器语言自动检测 + 用户偏好持久化 ===
        1) 读 localStorage.pal_lang（用户在 Header 切换过）
        2) 没存过 → 用 navigator.language 判断
        3) 当前路径不匹配 → 跳转到正确语言版本
        注：每次页面加载都跑（不是 sessionStorage 标记），
           因为同会话内切换语言需要重新生效；
           不会死循环——重定向到正确页后 currentLang === target 即返回。
    */}
    <script is:inline>
      (function () {
        try {
          // 0) 跳过爬虫/机器人 — 否则 Bingbot (英文环境) 会被重定向到 /en/，
          //    然后把 / 误判为 /en/ 的重复页，SEO 受损
          var ua = (navigator.userAgent || '').toLowerCase();
          if (/bot|spider|crawl|bingbot|googlebot|baiduspider|yandex|duckduck|slurp|facebookexternalhit|twitterbot|linkedinbot|embedly|quora|whatsapp|telegrambot|applebot|petalbot|sogou|360spider|bytespider/.test(ua)) {
            return;
          }

          var path = window.location.pathname;
          var isEnPath = path === '/en' || path.indexOf('/en/') === 0;
          var currentLang = isEnPath ? 'en' : 'zh';

          // 1) 用户偏好
          var saved = null;
          try { saved = localStorage.getItem('pal_lang'); } catch (e) {}
          if (saved !== 'zh' && saved !== 'en') saved = null;

          // 2) 浏览器语言
          var target = saved;
          if (!target) {
            var navLang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'en').toLowerCase();
            target = navLang.indexOf('zh') === 0 ? 'zh' : 'en';
          }

          if (currentLang === target) return;

          // 3) 计算目标路径
          var newPath;
          if (target === 'en') {
            newPath = '/en' + (path === '/' ? '/' : path);
          } else {
            newPath = path.replace(/^\/en(\/|$)/, '/');
            if (!newPath) newPath = '/';
          }

          // 4) 跳转（用 replace 不留 history）
          window.location.replace(newPath + window.location.search + window.location.hash);
        } catch (err) {
          // 静默失败，不影响正常访问
        }
      })();
    </script>
  </head>

  <body>
    <Header lang={finalLang} />

    {showTopAd && <AdSlot position="top" />}

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <AdSlot position="bottom" />

    <Footer lang={finalLang} />

    {/* AdSense 接入位 - 申请通过后开启 */}
    {/* <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXX" crossorigin="anonymous"></script> */}
  </body>
</html>

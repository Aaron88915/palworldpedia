---
import Layout from '@layouts/Layout.astro';
import PalImage from '@components/PalImage.astro';
import { PAL_TYPES, WORK_SUITABILITIES } from '@/config';
import palsData from '@data/pals.json';
import type { Pal } from '@data/types';

const pals = palsData as Pal[];

// 在 SSG 模式下，query 参数不参与构建——所有筛选改为客户端 JS 处理。
// 这里只渲染全部 288 只帕鲁，加 data 属性供客户端筛选。

// 预计算每只帕鲁的工作适配 ID 列表（用于 data-work）
const palsWithData = pals.map((p) => {
  const workEntries = Object.entries(p.workSuitability || {})
    .filter(([_, lvl]) => typeof lvl === 'number' && lvl > 0)
    .map(([k, lvl]) => `${k}:${lvl}`)
    .join(' ');
  const isVariant = p.paldeckNo === 0 || p.paldeckNo > 200;
  return { pal: p, workEntries, isVariant };
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Palworld 帕鲁图鉴',
  description: '所有 Palworld 帕鲁的完整图鉴，包含属性、技能、词条、捕捉位置。',
  numberOfItems: pals.length,
  itemListElement: pals.slice(0, 20).map((pal, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Thing',
      name: `${pal.name.zh} (${pal.name.en})`,
      url: new URL(`/pals/${pal.id}/`, Astro.site).href,
    },
  })),
};

// 暴露给客户端的配置
const config = {
  types: PAL_TYPES,
  works: WORK_SUITABILITIES,
};
---

<Layout
  title="帕鲁图鉴 - 全部 288 只 Palworld 帕鲁"
  description="完整的 Palworld 帕鲁图鉴。包含所有帕鲁的属性、技能、词条、捕捉位置、掉落物等详细信息。支持按属性、工作、稀有度筛选。"
  schema={schema}
>
  <header class="page-header">
    <h1>帕鲁图鉴</h1>
    <p class="text-secondary">共 {pals.length} 只帕鲁 · <span id="visible-count">显示 {pals.length}</span> 只</p>
  </header>

  <!-- 搜索框 -->
  <div class="filter-bar">
    <input
      type="search"
      id="pal-search"
      class="search-input"
      placeholder="搜索帕鲁（中文 / 英文 / ID）..."
      autocomplete="off"
    />

    <!-- 属性筛选 -->
    <div class="filter-row">
      <span class="filter-label">属性</span>
      <div class="filter-chips" data-filter-group="type">
        <button type="button" data-filter-value="" class="chip type-chip active">全部</button>
        {PAL_TYPES.map((t) => (
          <button
            type="button"
            data-filter-value={t.id}
            class={`chip type-chip type-${t.id}`}
          >
            {t.zh}
          </button>
        ))}
      </div>
    </div>

    <!-- 工作适配筛选 -->
    <div class="filter-row">
      <span class="filter-label">工作</span>
      <div class="filter-chips" data-filter-group="work">
        <button type="button" data-filter-value="" class="chip active">全部</button>
        {WORK_SUITABILITIES.map((w) => (
          <button
            type="button"
            data-filter-value={w.id}
            class="chip"
            title={w.zh}
          >
            <span class="chip-icon">{w.icon}</span>
            <span class="chip-text">{w.zh}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 稀有度 + 变种 + 排序 + 视图 -->
    <div class="filter-row meta-row">
      <div class="meta-group">
        <span class="filter-label">稀有度</span>
        <div class="filter-chips small" data-filter-group="rarity">
          <button type="button" data-filter-value="" class="chip active">全部</button>
          <button type="button" data-filter-value="Common" class="chip rarity-chip rarity-common">Common</button>
          <button type="button" data-filter-value="Rare" class="chip rarity-chip rarity-rare">Rare</button>
          <button type="button" data-filter-value="Epic" class="chip rarity-chip rarity-epic">Epic</button>
          <button type="button" data-filter-value="Legendary" class="chip rarity-chip rarity-legendary">Legendary</button>
        </div>
      </div>

      <div class="meta-group">
        <span class="filter-label">类型</span>
        <div class="filter-chips small" data-filter-group="variants">
          <button type="button" data-filter-value="all" class="chip active">全部</button>
          <button type="button" data-filter-value="base" class="chip">仅基础</button>
          <button type="button" data-filter-value="only" class="chip">仅变种</button>
        </div>
      </div>

      <div class="meta-group">
        <span class="filter-label">排序</span>
        <div class="filter-chips small" data-filter-group="sort">
          <button type="button" data-filter-value="no" class="chip active">图鉴号</button>
          <button type="button" data-filter-value="rarity" class="chip">稀有度</button>
          <button type="button" data-filter-value="name-zh" class="chip">中文名</button>
          <button type="button" data-filter-value="name-en" class="chip">英文名</button>
        </div>
      </div>

      <div class="meta-group">
        <span class="filter-label">视图</span>
        <div class="filter-chips small" data-filter-group="view">
          <button type="button" data-filter-value="grid" class="chip active">网格</button>
          <button type="button" data-filter-value="grouped" class="chip">分组</button>
        </div>
      </div>
    </div>

    <!-- 已选筛选器 -->
    <div class="active-filters" id="active-filters" style="display: none;">
      <span class="filter-label">已筛选</span>
      <div id="active-chips"></div>
      <button type="button" id="reset-btn" class="reset-link">清空</button>
    </div>
  </div>

  <!-- 帕鲁网格（默认） -->
  <div class="pal-grid" id="pal-grid">
    {palsWithData.map(({ pal, workEntries, isVariant }) => (
      <a
        href={`/pals/${pal.id}/`}
        class="pal-tile"
        data-id={pal.id}
        data-name-zh={pal.name.zh.toLowerCase()}
        data-name-en={pal.name.en.toLowerCase()}
        data-type={pal.types.join(' ')}
        data-work={workEntries}
        data-rarity={pal.rarityTier || 'Common'}
        data-rarity-num={pal.rarity}
        data-variant={isVariant ? 'only' : 'base'}
        data-paldeck={pal.paldeckNo}
      >
        <div class="pal-tile-img">
          <PalImage pal={pal} size="medium" rounded />
          <div class="pal-tile-no">#{pal.paldeckNo.toString().padStart(3, '0')}</div>
          <div class={`pal-tile-rarity rarity-${(pal.rarityTier || 'common').toLowerCase()}`}>{pal.rarityTier || 'Common'}</div>
        </div>
        <div class="pal-tile-info">
          <div class="pal-tile-name">{pal.name.zh}</div>
          <div class="pal-tile-name-en">{pal.name.en}</div>
          <div class="pal-tile-types">
            {pal.types.map((type) => (
              <span class={`type-dot type-${type}`}></span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>

  {pals.length === 0 && (
    <div class="empty-state">
      <p>未找到匹配的帕鲁</p>
    </div>
  )}
</Layout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .filter-bar {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 1rem;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    min-width: 48px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-chips {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .filter-chips.small .chip {
    padding: 0.25rem 0.625rem;
    font-size: 0.8125rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: all 0.15s ease;
    white-space: nowrap;
    cursor: pointer;
    font-family: inherit;
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .chip.active {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
    font-weight: 600;
  }

  .chip-icon {
    font-size: 1em;
  }

  .rarity-chip:not(.active) {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .meta-row {
    gap: 1rem;
  }

  .meta-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-group .filter-label {
    min-width: auto;
  }

  .active-filters {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.625rem 0.875rem;
    background: var(--bg-tertiary);
    border-radius: var(--radius);
  }

  .active-chip {
    padding: 0.25rem 0.625rem;
    background: var(--accent);
    color: #000;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .active-chip:hover {
    background: #ff9d4a;
  }

  .reset-link {
    color: var(--text-muted);
    font-size: 0.8125rem;
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }

  .reset-link:hover {
    color: var(--accent);
  }

  .pal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .pal-tile {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.15s ease;
    color: inherit;
  }

  .pal-tile:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .pal-tile.hidden {
    display: none;
  }

  .pal-tile-img {
    aspect-ratio: 1;
    background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .pal-tile-emoji {
    font-size: 3rem;
  }

  .pal-tile-no {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-size: 0.625rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .pal-tile-rarity {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.125rem 0.4rem;
    border-radius: 0.25rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .pal-tile-rarity.rarity-common { background: rgba(150,150,150,0.2); color: #c0c0c0; }
  .pal-tile-rarity.rarity-rare { background: rgba(80,170,255,0.2); color: #5cb0ff; }
  .pal-tile-rarity.rarity-epic { background: rgba(180,90,255,0.2); color: #c878ff; }
  .pal-tile-rarity.rarity-legendary { background: rgba(255,180,40,0.2); color: #ffb830; }

  .rarity-chip.rarity-common.active { border-color: #c0c0c0; color: #c0c0c0; }
  .rarity-chip.rarity-rare.active { border-color: #5cb0ff; color: #5cb0ff; }
  .rarity-chip.rarity-epic.active { border-color: #c878ff; color: #c878ff; }
  .rarity-chip.rarity-legendary.active { border-color: #ffb830; color: #ffb830; }

  .pal-tile-info {
    padding: 0.5rem 0.75rem 0.75rem;
  }

  .pal-tile-name {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .pal-tile-name-en {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .pal-tile-types {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .type-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .type-neutral { background: #a0a8b0; }
  .type-fire { background: #f87171; }
  .type-water { background: #5eb3f5; }
  .type-grass { background: #4ade80; }
  .type-electric { background: #fbbf24; }
  .type-ice { background: #93c5fd; }
  .type-ground { background: #d97706; }
  .type-dark { background: #6b7280; }
  .type-dragon { background: #c084fc; }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }

  /* 分组视图（JS 动态生成） */
  .pal-groups {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    border-radius: var(--radius);
    margin-bottom: 1rem;
    border-left: 4px solid;
    color: var(--text-primary);
  }

  .group-header.type-neutral { border-color: #a0a8b0; }
  .group-header.type-fire { border-color: #f87171; }
  .group-header.type-water { border-color: #5eb3f5; }
  .group-header.type-grass { border-color: #4ade80; }
  .group-header.type-electric { border-color: #fbbf24; }
  .group-header.type-ice { border-color: #93c5fd; }
  .group-header.type-ground { border-color: #d97706; }
  .group-header.type-dark { border-color: #6b7280; }
  .group-header.type-dragon { border-color: #c084fc; }

  .group-count {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>

<script define:vars={{ config }}>
  // ===== 客户端筛选系统 =====

  const state = {
    type: '',
    work: '',
    rarity: '',
    sort: 'no',
    variants: 'all',
    view: 'grid',
    q: '',
  };

  const grid = document.getElementById('pal-grid');
  const tiles = Array.from(document.querySelectorAll('.pal-tile'));
  const search = document.getElementById('pal-search');
  const visibleCount = document.getElementById('visible-count');
  const activeBox = document.getElementById('active-filters');
  const activeChips = document.getElementById('active-chips');
  const resetBtn = document.getElementById('reset-btn');

  // 从 URL 初始化 state
  function initFromURL() {
    const sp = new URLSearchParams(window.location.search);
    if (sp.get('type')) state.type = sp.get('type');
    if (sp.get('work')) state.work = sp.get('work');
    if (sp.get('rarity')) state.rarity = sp.get('rarity');
    if (sp.get('sort')) state.sort = sp.get('sort');
    if (sp.get('variants')) state.variants = sp.get('variants');
    if (sp.get('view')) state.view = sp.get('view');
    if (sp.get('q')) {
      state.q = sp.get('q');
      if (search) search.value = state.q;
    }
  }

  // 应用筛选
  function applyFilter() {
    let visible = 0;

    tiles.forEach((tile) => {
      const el = tile;
      const types = (el.dataset.type || '').split(' ');
      const workData = el.dataset.work || '';
      const rarity = el.dataset.rarity;
      const variant = el.dataset.variant;
      const nameZh = el.dataset.nameZh || '';
      const nameEn = el.dataset.nameEn || '';

      let match = true;

      // 1. 属性筛选
      if (state.type && !types.includes(state.type)) match = false;

      // 2. 工作筛选
      if (match && state.work) {
        const workMatch = workData.split(' ').some((entry) => entry.startsWith(state.work + ':'));
        if (!workMatch) match = false;
      }

      // 3. 稀有度
      if (match && state.rarity && rarity !== state.rarity) match = false;

      // 4. 变种
      if (match && state.variants === 'base' && variant !== 'base') match = false;
      if (match && state.variants === 'only' && variant !== 'only') match = false;

      // 5. 搜索
      if (match && state.q) {
        const q = state.q.toLowerCase();
        if (!nameZh.includes(q) && !nameEn.includes(q) && !el.dataset.id.includes(q)) match = false;
      }

      el.classList.toggle('hidden', !match);
      if (match) visible++;
    });

    if (visibleCount) visibleCount.textContent = `显示 ${visible}`;

    // 排序
    sortTiles();
    // 分组视图
    renderView();
    // 更新 active filter 显示
    updateActiveChips();
    // 更新 chip 选中状态
    syncChipState();
  }

  function sortTiles() {
    const sorted = [...tiles].sort((a, b) => {
      switch (state.sort) {
        case 'rarity':
          if (Number(b.dataset.rarityNum) !== Number(a.dataset.rarityNum)) return Number(b.dataset.rarityNum) - Number(a.dataset.rarityNum);
          return Number(a.dataset.paldeck) - Number(b.dataset.paldeck);
        case 'name-zh':
          return (a.dataset.nameZh || '').localeCompare(b.dataset.nameZh || '', 'zh');
        case 'name-en':
          return (a.dataset.nameEn || '').localeCompare(b.dataset.nameEn || '');
        case 'no':
        default:
          return Number(a.dataset.paldeck) - Number(b.dataset.paldeck);
      }
    });
    sorted.forEach((t) => grid.appendChild(t));
  }

  function renderView() {
    if (state.view === 'grouped') {
      // 简单实现：保持 grid 模式但通过 CSS class 提示
      grid.classList.add('view-grouped');
      // TODO: 完整分组视图需要重排 DOM
    } else {
      grid.classList.remove('view-grouped');
    }
  }

  function updateActiveChips() {
    const labels = {
      type: state.type ? config.types.find((t) => t.id === state.type)?.zh : null,
      work: state.work ? config.works.find((w) => w.id === state.work)?.zh : null,
      rarity: state.rarity || null,
      variants: state.variants === 'base' ? '仅基础' : state.variants === 'only' ? '仅变种' : null,
    };
    const entries = Object.entries(labels).filter(([_, v]) => v);
    if (entries.length === 0) {
      activeBox.style.display = 'none';
      return;
    }
    activeBox.style.display = 'flex';
    activeChips.innerHTML = entries.map(([k, v]) => {
      const removeAttr = `data-remove-key="${k}"`;
      return `<button type="button" class="active-chip" ${removeAttr}>× ${v}</button>`;
    }).join('');
  }

  function syncChipState() {
    document.querySelectorAll('[data-filter-group]').forEach((group) => {
      const key = group.dataset.filterGroup;
      const val = state[key] || '';
      group.querySelectorAll('.chip').forEach((chip) => {
        const cv = chip.dataset.filterValue || '';
        chip.classList.toggle('active', cv === val || (key === 'variants' && cv === state.variants));
      });
    });
  }

  // 更新 URL
  function updateURL() {
    const sp = new URLSearchParams();
    if (state.type) sp.set('type', state.type);
    if (state.work) sp.set('work', state.work);
    if (state.rarity) sp.set('rarity', state.rarity);
    if (state.sort && state.sort !== 'no') sp.set('sort', state.sort);
    if (state.variants && state.variants !== 'all') sp.set('variants', state.variants);
    if (state.view && state.view !== 'grid') sp.set('view', state.view);
    if (state.q) sp.set('q', state.q);
    const qs = sp.toString();
    const newURL = window.location.pathname + (qs ? '?' + qs : '');
    window.history.replaceState({}, '', newURL);
  }

  // 绑定 chip 点击
  document.querySelectorAll('[data-filter-group]').forEach((group) => {
    const key = group.dataset.filterGroup;
    group.addEventListener('click', (e) => {
      const btn = e.target.closest('.chip');
      if (!btn) return;
      const val = btn.dataset.filterValue || '';
      state[key] = val;
      updateURL();
      applyFilter();
    });
  });

  // 搜索框
  let searchTimer;
  if (search) {
    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        state.q = search.value.trim();
        updateURL();
        applyFilter();
      }, 200);
    });
  }

  // 已选筛选 chip 点击移除
  if (activeChips) {
    activeChips.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-remove-key]');
      if (!btn) return;
      const key = btn.dataset.removeKey;
      if (key === 'type') state.type = '';
      if (key === 'work') state.work = '';
      if (key === 'rarity') state.rarity = '';
      if (key === 'variants') state.variants = 'all';
      updateURL();
      applyFilter();
    });
  }

  // 重置
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      state.type = '';
      state.work = '';
      state.rarity = '';
      state.sort = 'no';
      state.variants = 'all';
      state.view = 'grid';
      state.q = '';
      if (search) search.value = '';
      updateURL();
      applyFilter();
    });
  }

  // 浏览器前进/后退
  window.addEventListener('popstate', () => {
    initFromURL();
    if (search) search.value = state.q;
    applyFilter();
  });

  // 初始化
  initFromURL();
  applyFilter();
</script>

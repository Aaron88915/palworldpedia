---
import Layout from '@layouts/Layout.astro';
import { PAL_TYPES } from '@/config';
import palsData from '@data/pals.json';
import type { Pal } from '@data/types';

const pals = palsData as Pal[];
const url = new URL(Astro.request.url);
const typeFilter = url.searchParams.get('type');
const searchQuery = url.searchParams.get('q')?.toLowerCase() || '';

let filteredPals = pals;

if (typeFilter && PAL_TYPES.some((t) => t.id === typeFilter)) {
  filteredPals = filteredPals.filter((p) => p.types.includes(typeFilter as any));
}

if (searchQuery) {
  filteredPals = filteredPals.filter((p) =>
    p.name.zh.toLowerCase().includes(searchQuery) ||
    p.name.en.toLowerCase().includes(searchQuery) ||
    p.id.includes(searchQuery)
  );
}

// 按图鉴编号排序
filteredPals.sort((a, b) => a.paldeckNo - b.paldeckNo);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Palworld 帕鲁图鉴',
  description: '所有 Palworld 帕鲁的完整图鉴，包含属性、技能、词条、捕捉位置。',
  numberOfItems: pals.length,
  itemListElement: pals.slice(0, 20).map((pal, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Thing',
      name: `${pal.name.zh} (${pal.name.en})`,
      url: new URL(`/pals/${pal.id}/`, Astro.site).href,
    },
  })),
};
---

<Layout
  title={typeFilter ? `${PAL_TYPES.find((t) => t.id === typeFilter)?.zh}属性帕鲁` : '帕鲁图鉴'}
  description="完整的 Palworld 帕鲁图鉴。包含所有帕鲁的属性、技能、词条、捕捉位置、掉落物等详细信息。"
  schema={schema}
>
  <header class="page-header">
    <h1>帕鲁图鉴</h1>
    <p class="text-secondary">共 {pals.length} 只帕鲁 · 持续更新中</p>
  </header>

  <!-- 搜索框 + 类型筛选 -->
  <div class="filter-bar">
    <input
      type="search"
      id="pal-search"
      class="search-input"
      placeholder="搜索帕鲁（中文 / 英文）..."
      value={searchQuery}
      autocomplete="off"
    />
    <div class="type-filters">
      <a href="/pals/" class={`type-chip ${!typeFilter ? 'active' : ''}`}>全部</a>
      {PAL_TYPES.map((type) => (
        <a
          href={`/pals/?type=${type.id}`}
          class={`type-chip type-${type.id} ${typeFilter === type.id ? 'active' : ''}`}
        >
          {type.zh}
        </a>
      ))}
    </div>
  </div>

  <!-- 帕鲁网格 -->
  <div class="pal-grid" id="pal-grid">
    {filteredPals.map((pal) => (
      <a href={`/pals/${pal.id}/`} class="pal-tile" data-name-zh={pal.name.zh.toLowerCase()} data-name-en={pal.name.en.toLowerCase()}>
        <div class="pal-tile-img">
          <span class="pal-tile-emoji">{pal.types[0] === 'fire' ? '🔥' : pal.types[0] === 'water' ? '💧' : pal.types[0] === 'grass' ? '🌿' : pal.types[0] === 'electric' ? '⚡' : pal.types[0] === 'ice' ? '❄️' : pal.types[0] === 'dark' ? '🌑' : pal.types[0] === 'dragon' ? '🐉' : '⭐'}</span>
          <div class="pal-tile-no">#{pal.paldeckNo.toString().padStart(3, '0')}</div>
        </div>
        <div class="pal-tile-info">
          <div class="pal-tile-name">{pal.name.zh}</div>
          <div class="pal-tile-name-en">{pal.name.en}</div>
          <div class="pal-tile-types">
            {pal.types.map((type) => (
              <span class={`type-dot type-${type}`}></span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>

  {filteredPals.length === 0 && (
    <div class="empty-state">
      <p>未找到匹配的帕鲁</p>
    </div>
  )}
</Layout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .filter-bar {
    margin-bottom: 1.5rem;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .type-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .type-chip {
    padding: 0.375rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: all 0.15s ease;
  }

  .type-chip:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .type-chip.active {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .pal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .pal-tile {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.15s ease;
    color: inherit;
  }

  .pal-tile:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .pal-tile-img {
    aspect-ratio: 1;
    background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .pal-tile-emoji {
    font-size: 3rem;
  }

  .pal-tile-no {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-size: 0.625rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .pal-tile-info {
    padding: 0.5rem 0.75rem 0.75rem;
  }

  .pal-tile-name {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .pal-tile-name-en {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .pal-tile-types {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .type-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }
</style>

<script>
  // 客户端搜索过滤
  const search = document.getElementById('pal-search') as HTMLInputElement;
  const grid = document.getElementById('pal-grid');
  const tiles = grid?.querySelectorAll('.pal-tile');

  if (search && tiles) {
    let timer: number;
    search.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const q = search.value.toLowerCase().trim();
        tiles.forEach((tile) => {
          const el = tile as HTMLElement;
          const zh = el.dataset.nameZh || '';
          const en = el.dataset.nameEn || '';
          const match = !q || zh.includes(q) || en.includes(q);
          el.style.display = match ? '' : 'none';
        });
      }, 200);
    });
  }
</script>

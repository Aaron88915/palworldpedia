---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import { SITE } from '@/config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Palworld 配种计算器',
  description: 'Palworld 配种计算器 - 输入两只帕鲁，立即计算后代配方。支持反向查询（目标帕鲁→父母）和最短配种路径。',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
};
---

<Layout
  title="配种计算器 - Palworld 帕鲁繁殖公式"
  description="Palworld 配种计算器 - 输入两只帕鲁立即计算后代，40972 条完整配种表，反向查询父母组合，独家最短配种路径 BFS 算法助你快速孵化目标"
  schema={schema}
>
  <header class="page-header">
    <h1>🧬 配种计算器</h1>
    <p class="text-secondary">输入两只帕鲁 → 查后代 · 选目标 → 反查父母 · 跨 N 代孵目标 → 最短路径</p>
  </header>

  <!-- Tab 切换 -->
  <nav class="tabs">
    <button class="tab-btn active" data-tab="forward">父母 → 后代</button>
    <button class="tab-btn" data-tab="reverse">目标 → 父母</button>
    <button class="tab-btn" data-tab="path">最短配种链</button>
    <button class="tab-btn" data-tab="finder">🗺️ Path Finder</button>
  </nav>

  <!-- Tab 1: 父母 → 后代 -->
  <section class="tab-panel active" id="tab-forward">
    <div class="breeder-grid">
      <div class="parent-slot">
        <label class="parent-label">父母 A</label>
        <select id="parent-a" class="parent-select">
          <option value="">选择帕鲁 A...</option>
        </select>
        <div id="parent-a-preview" class="parent-preview"></div>
      </div>
      <div class="plus-icon">+</div>
      <div class="parent-slot">
        <label class="parent-label">父母 B</label>
        <select id="parent-b" class="parent-select">
          <option value="">选择帕鲁 B...</option>
        </select>
        <div id="parent-b-preview" class="parent-preview"></div>
      </div>
    </div>
    <div class="result-area">
      <div class="result-arrow">↓</div>
      <div id="forward-result" class="result-box">
        <p class="text-muted">请选择两只帕鲁以查看结果</p>
      </div>
    </div>
  </section>

  <!-- Tab 2: 目标 → 父母 -->
  <section class="tab-panel" id="tab-reverse">
    <div class="single-slot">
      <label class="parent-label">目标帕鲁（想孵出）</label>
      <select id="target-pal" class="parent-select">
        <option value="">选择目标帕鲁...</option>
      </select>
      <div id="target-preview" class="parent-preview"></div>
    </div>
    <div class="result-area">
      <div class="result-arrow">↑</div>
      <div id="reverse-result" class="result-box">
        <p class="text-muted">选择目标帕鲁，列出所有可能的父母组合</p>
      </div>
    </div>
  </section>

  <!-- Tab 3: 最短配种链 -->
  <section class="tab-panel" id="tab-path">
    <p class="text-secondary mb-2">输入起始帕鲁（你已有的）和目标帕鲁（想孵的），自动找出最短的配种链。</p>
    <div class="breeder-grid">
      <div class="parent-slot">
        <label class="parent-label">起始帕鲁（已有）</label>
        <select id="start-pal" class="parent-select">
          <option value="">选择起始帕鲁...</option>
        </select>
      </div>
      <div class="plus-icon">→</div>
      <div class="parent-slot">
        <label class="parent-label">目标帕鲁</label>
        <select id="end-pal" class="parent-select">
          <option value="">选择目标帕鲁...</option>
        </select>
      </div>
    </div>
    <div class="result-area">
      <div class="result-arrow">→</div>
      <div id="path-result" class="result-box">
        <p class="text-muted">选择起始 + 目标帕鲁，查找最短配种链</p>
      </div>
    </div>
  </section>

  <!-- Tab 4: Path Finder (多源 BFS) -->
  <section class="tab-panel" id="tab-finder">
    <p class="text-secondary mb-2">🗺️ 勾选你<strong>已有的帕鲁</strong>，选择想孵的<strong>目标</strong>，自动找出最优配种链（多源 BFS 算法）。</p>

    <div class="finder-target-row">
      <label class="parent-label">🎯 目标帕鲁（想孵出）</label>
      <select id="finder-target" class="parent-select finder-target-select">
        <option value="">选择目标帕鲁...</option>
      </select>
    </div>

    <div class="finder-owned-section">
      <div class="finder-owned-head">
        <label class="parent-label">📦 我已有的帕鲁（<span id="owned-count">0</span>）</label>
        <div class="finder-owned-tools">
          <button type="button" class="btn-chip" id="btn-clear-owned">清空</button>
          <button type="button" class="btn-chip" id="btn-preset-starters">常用帕鲁</button>
        </div>
      </div>
      <div class="finder-search-row">
        <input type="search" id="finder-search" class="finder-search" placeholder="搜索帕鲁名（中/英），点击下方列表添加..." autocomplete="off" />
      </div>
      <div class="finder-pal-grid" id="finder-pal-grid">
        <!-- 全部 288 只帕鲁通过 JS 渲染 -->
      </div>
      <div class="finder-selected-chips" id="finder-selected-chips">
        <!-- 选中的帕鲁作为 chip 显示 -->
      </div>
    </div>

    <div class="result-area">
      <div class="result-arrow">→</div>
      <div id="finder-result" class="result-box">
        <p class="text-muted">勾选你已有的帕鲁 + 选择目标帕鲁，查找最优配种链</p>
      </div>
    </div>
  </section>

  <AdSlot position="inline" />

  <!-- 完整配种表（可筛选） -->
  <section class="mt-4">
    <div class="flex items-center justify-between mb-2">
      <h2>📋 完整配种表</h2>
      <span class="text-secondary" id="edge-count">加载中...</span>
    </div>
    <input
      type="search"
      id="edge-search"
      class="edge-search"
      placeholder="搜索帕鲁名（中/英）..."
      autocomplete="off"
    />
    <div class="table-wrapper">
      <table id="edge-table">
        <thead>
          <tr>
            <th>父母 A</th>
            <th></th>
            <th>父母 B</th>
            <th>→</th>
            <th>后代</th>
          </tr>
        </thead>
        <tbody id="edge-tbody">
          <tr><td colspan="5" class="text-center text-muted">加载配种数据中...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- SEO 文本 -->
  <section class="seo-text mt-4">
    <h2>关于 Palworld 配种系统</h2>
    <p>
      Palworld 的配种系统是游戏的核心玩法之一。通过将两只不同（可相同）性别的帕鲁放入<strong>配种牧场</strong>，
      可以孵出全新的帕鲁。许多稀有和强大的帕鲁只能通过配种获得。
    </p>
    <p>本计算器支持四种查询模式：</p>
    <ul>
      <li><strong>父母 → 后代</strong>：输入 A 和 B，立即算出能孵出什么</li>
      <li><strong>目标 → 父母</strong>：想孵某只帕鲁，列出所有可能的父母组合</li>
      <li><strong>最短配种链</strong>：已有 A，想孵 Z，自动找 A → ... → Z 的最短路径（单源 BFS）</li>
      <li><strong>Path Finder</strong>：勾选你<strong>全部已有的帕鲁</strong>，从整个集合出发找出到目标的最优路径（多源 BFS）— 玩家视角的最实用功能</li>
    </ul>
  </section>
</Layout>

<script>
  // 加载帕鲁 + 配种数据（从 public/ JSON）
  // breeding-data.json 现在是紧凑索引格式: [[idx1, idx2, child_idx], ...]
  // pals-data.json 是 {id, zh, en, types, img}[]
  let pals = null;
  let edges = null;
  // 派生查找表
  let idxToId = null;        // index -> id
  let idToIdx = null;        // id -> index
  let forwardMap = null;     // "idx1|idx2" (排序) -> child_idx
  let reverseMap = null;     // child_idx -> [p1_idx, p2_idx][]
  let adjMap = null;         // parent_idx -> Set<child_idx>
  let edgeList = null;       // [{p1, p2, c, p1Id, p2Id, cId}, ...] 用于表格
  const palMap = new Map();

  async function getPals() {
    if (!pals) {
      const res = await fetch('/pals-data.json');
      pals = await res.json();
    }
    return pals;
  }

  async function getData() {
    if (edges) return { pals, edges, idxToId, idToIdx, forwardMap, reverseMap, adjMap, edgeList };
    pals = await getPals();
    const res = await fetch('/breeding-data.json');
    edges = await res.json();

    // 构建索引
    idxToId = pals.map((p) => p.id);
    idToIdx = new Map(pals.map((p, i) => [p.id, i]));

    forwardMap = new Map();
    reverseMap = new Map();
    adjMap = new Map();
    edgeList = [];

    for (const [i1, i2, c] of edges) {
      // 父对归一化 (排序)
      const a = i1 < i2 ? i1 : i2;
      const b = i1 < i2 ? i2 : i1;
      const key = a + '|' + b;
      // 同对多子保留第一个（理论上矩阵里只有 1 个）
      if (!forwardMap.has(key)) forwardMap.set(key, c);
      // 反向表
      if (!reverseMap.has(c)) reverseMap.set(c, []);
      reverseMap.get(c).push([a, b]);
      // 邻接表（BFS）
      if (!adjMap.has(a)) adjMap.set(a, new Set());
      if (!adjMap.has(b)) adjMap.set(b, new Set());
      adjMap.get(a).add(c);
      adjMap.get(b).add(c);
      // 边列表（用 ID 形式）
      edgeList.push({
        p1: idxToId[a], p2: idxToId[b], c: idxToId[c],
        p1Id: a, p2Id: b, cId: c,
      });
    }

    return { pals, edges, idxToId, idToIdx, forwardMap, reverseMap, adjMap, edgeList };
  }

  async function init() {
    const data = await getData();
    data.pals.forEach((p) => palMap.set(p.id, p));
    // 按中文名（拼音）排序
    const sortedPals = [...data.pals].sort((a, b) => (a.zh || '').localeCompare(b.zh || '', 'zh'));
    // 下拉项：显示 breedRank 星级（★1 最容易配，★5 最难）
    const opts = sortedPals.map((p) => {
      const stars = p.breedRank ? '★'.repeat(p.breedRank) : '';
      return `<option value="${p.id}">${p.zh} (${p.en}) ${stars}</option>`;
    }).join('');
    document.getElementById('parent-a').innerHTML = '<option value="">选择帕鲁 A...</option>' + opts;
    document.getElementById('parent-b').innerHTML = '<option value="">选择帕鲁 B...</option>' + opts;
    document.getElementById('target-pal').innerHTML = '<option value="">选择目标帕鲁...</option>' + opts;
    document.getElementById('start-pal').innerHTML = '<option value="">选择起始帕鲁...</option>' + opts;
    document.getElementById('end-pal').innerHTML = '<option value="">选择目标帕鲁...</option>' + opts;
    document.getElementById('edge-count').textContent = `共 ${data.edgeList.length} 条边`;
    loadEdgeTable();
  }

  function palCard(p) {
    if (!p) return '';
    return `<a href="/pals/${p.id}/" class="result-pal-link">
      <div class="result-pal-name">${p.zh}</div>
    </a>`;
  }

  // Tab 切换
  document.querySelectorAll('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });

  // Forward: A+B → C
  async function findChildren(a, b) {
    const data = await getData();
    const ia = data.idToIdx.get(a);
    const ib = data.idToIdx.get(b);
    if (ia === undefined || ib === undefined) return [];
    const key = (ia < ib ? ia : ib) + '|' + (ia < ib ? ib : ia);
    const c = data.forwardMap.get(key);
    return c !== undefined ? [data.idxToId[c]] : [];
  }

  async function showForward() {
    const a = document.getElementById('parent-a').value;
    const b = document.getElementById('parent-b').value;
    const palA = palMap.get(a);
    const palB = palMap.get(b);
    document.getElementById('parent-a-preview').innerHTML = palCard(palA);
    document.getElementById('parent-b-preview').innerHTML = palCard(palB);

    const out = document.getElementById('forward-result');
    if (!a || !b) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">请选择两只帕鲁以查看结果</p>';
      return;
    }
    if (a === b) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">同种配对通常孵出同种，请选择不同的两只帕鲁</p>';
      return;
    }
    const childIds = await findChildren(a, b);
    if (childIds.length === 0) {
      out.className = 'result-box';
      // 提示反向查询
      out.innerHTML = `
        <p class="text-muted">未找到 ${palA?.zh || a} + ${palB?.zh || b} 的已知配种组合。</p>
        <p class="text-secondary mt-2">提示：试试切换到 <strong>反向查询</strong> 标签页，
        输入你想孵的目标帕鲁。</p>
      `;
      return;
    }
    out.className = 'result-box has-result';
    const childrenHtml = childIds
      .map((id) => palCard(palMap.get(id)))
      .filter(Boolean)
      .join('');
    out.innerHTML = `
      <p class="mb-2">可能孵出：</p>
      <div class="result-pal-grid">${childrenHtml}</div>
    `;
  }

  document.getElementById('parent-a').addEventListener('change', showForward);
  document.getElementById('parent-b').addEventListener('change', showForward);

  // Reverse: C → A+B
  async function showReverse() {
    const c = document.getElementById('target-pal').value;
    const palC = palMap.get(c);
    document.getElementById('target-preview').innerHTML = palCard(palC);

    const out = document.getElementById('reverse-result');
    if (!c) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">选择目标帕鲁，列出所有可能的父母组合</p>';
      return;
    }
    const data = await getData();
    const idx = data.idToIdx.get(c);
    if (idx === undefined) {
      out.className = 'result-box';
      out.innerHTML = `<p class="text-muted">找不到 ${palC?.zh || c} 的数据</p>`;
      return;
    }
    const pairs = data.reverseMap.get(idx) || [];
    if (pairs.length === 0) {
      out.className = 'result-box';
      out.innerHTML = `<p class="text-muted">${palC?.zh || c} 没有已知的配种记录</p>`;
      return;
    }
    out.className = 'result-box has-result';
    // 去重（理论上 [a,b] 已经是 sorted，但以防万一）
    const uniquePairs = new Map();
    for (const [p1i, p2i] of pairs) {
      const key = p1i < p2i ? `${p1i}|${p2i}` : `${p2i}|${p1i}`;
      if (!uniquePairs.has(key)) uniquePairs.set(key, [p1i, p2i]);
    }
    const rows = Array.from(uniquePairs.values())
      .map(([i1, i2]) => {
        const p1 = data.pals[i1];
        const p2 = data.pals[i2];
        if (!p1 || !p2) return '';
        return `<tr>
          <td>${palCard(p1)}</td>
          <td class="text-center">+</td>
          <td>${palCard(p2)}</td>
        </tr>`;
      })
      .filter(Boolean)
      .join('');
    out.innerHTML = `
      <p class="mb-2"><strong>${palC?.zh || c}</strong> 可由 <strong>${uniquePairs.size}</strong> 种父母组合孵出：</p>
      <div class="table-wrapper">
        <table><tbody>${rows}</tbody></table>
      </div>
    `;
  }
  document.getElementById('target-pal').addEventListener('change', showReverse);

  // Shortest path: A → C via BFS
  async function findShortestPath(startId, endId) {
    const data = await getData();
    const start = data.idToIdx.get(startId);
    const end = data.idToIdx.get(endId);
    if (start === undefined || end === undefined) return null;
    if (start === end) return [start];

    // BFS over pal indices
    const queue = [{ node: start, path: [start] }];
    const visited = new Set([start]);
    while (queue.length > 0) {
      const { node, path } = queue.shift();
      const neighbors = data.adjMap.get(node);
      if (!neighbors) continue;
      for (const next of neighbors) {
        if (visited.has(next)) continue;
        visited.add(next);
        const newPath = [...path, next];
        if (next === end) return newPath;
        queue.push({ node: next, path: newPath });
      }
    }
    return null;
  }

  async function showPath() {
    const start = document.getElementById('start-pal').value;
    const end = document.getElementById('end-pal').value;
    const out = document.getElementById('path-result');
    if (!start || !end) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">选择起始 + 目标帕鲁，查找最短配种链</p>';
      return;
    }
    if (start === end) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">起始和目标相同</p>';
      return;
    }
    const path = await findShortestPath(start, end);
    if (!path) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">找不到连接这两个帕鲁的配种链</p>';
      return;
    }
    out.className = 'result-box has-result';
    const steps = path
      .map((idx, i) => {
        const p = data.pals[idx];
        if (!p) return '';
        const arrow = i < path.length - 1 ? '<span class="path-arrow">↓</span>' : '';
        return `<div class="path-step">${palCard(p)}${arrow}</div>`;
      })
      .filter(Boolean)
      .join('');
    const palStart = palMap.get(start);
    const palEnd = palMap.get(end);
    const stepsDesc =
      path.length === 2
        ? `直接配种 ${palStart?.zh} × ${palEnd?.zh}`
        : `需要 <strong>${path.length - 1}</strong> 步配种`;
    out.innerHTML = `
      <p class="mb-2">${stepsDesc}</p>
      <div class="path-flow">${steps}</div>
    `;
  }
  document.getElementById('start-pal').addEventListener('change', showPath);
  document.getElementById('end-pal').addEventListener('change', showPath);

  // === Path Finder (多源 BFS) ===
  // 玩家从多个起点（"我拥有的帕鲁"集合）出发，找最短路径到目标
  // 区别于上面 Tab 3 的单源 BFS
  const STARTER_PRESET = [
    'lamball', 'cattiva', 'lifmunk', 'foxparks', 'hoocrates', 'teafant',
    'pengullet', 'jormuntide', 'anubis', 'mau', 'faleris',
    'grizzbolt', 'relaxaurus', 'chillet', 'flopie', 'gumoss', 'daedream',
    'killamari', 'flambelle', 'pengullet', 'mozzarina',
  ];

  // 选中的 owned 帕鲁（Set<id>）
  const ownedSet = new Set();
  let finderGridRendered = false;

  async function initFinder() {
    const data = await getData();
    // 目标下拉
    const sortedPals = [...data.pals].sort((a, b) => (a.zh || '').localeCompare(b.zh || '', 'zh'));
    const targetOpts = sortedPals.map((p) => {
      const stars = p.breedRank ? '★'.repeat(p.breedRank) : '';
      return `<option value="${p.id}">${p.zh} (${p.en}) ${stars}</option>`;
    }).join('');
    document.getElementById('finder-target').innerHTML = '<option value="">选择目标帕鲁...</option>' + targetOpts;

    // 渲染 288 只帕鲁的网格（按 breedRank 升序，breedRank=5 排前面 — 容易配的放前面）
    const grid = document.getElementById('finder-pal-grid');
    if (!finderGridRendered) {
      const cellHtml = data.pals
        .map((p) => {
          const stars = p.breedRank ? '★'.repeat(p.breedRank) : '';
          return `<div class="finder-pal-cell" data-pal-id="${p.id}" data-zh="${(p.zh || '').toLowerCase()}" data-en="${(p.en || '').toLowerCase()}">
            <div class="finder-pal-name">${p.zh}</div>
            <div class="finder-pal-meta">${stars}</div>
          </div>`;
        })
        .join('');
      grid.innerHTML = cellHtml;
      finderGridRendered = true;

      // 点击 toggle owned
      grid.addEventListener('click', (e) => {
        const cell = e.target.closest('.finder-pal-cell');
        if (!cell) return;
        const id = cell.dataset.palId;
        if (ownedSet.has(id)) {
          ownedSet.delete(id);
        } else {
          ownedSet.add(id);
        }
        cell.classList.toggle('selected');
        updateOwnedUI();
        runFinder();
      });
    }

    // 搜索过滤
    document.getElementById('finder-search').addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      grid.querySelectorAll('.finder-pal-cell').forEach((cell) => {
        const match = !q || cell.dataset.zh.includes(q) || cell.dataset.en.includes(q);
        cell.style.display = match ? '' : 'none';
      });
    });

    // 工具按钮
    document.getElementById('btn-clear-owned').addEventListener('click', () => {
      ownedSet.clear();
      grid.querySelectorAll('.finder-pal-cell.selected').forEach((c) => c.classList.remove('selected'));
      updateOwnedUI();
      runFinder();
    });

    document.getElementById('btn-preset-starters').addEventListener('click', () => {
      ownedSet.clear();
      STARTER_PRESET.forEach((id) => ownedSet.add(id));
      grid.querySelectorAll('.finder-pal-cell').forEach((c) => {
        c.classList.toggle('selected', ownedSet.has(c.dataset.palId));
      });
      updateOwnedUI();
      runFinder();
    });

    // 目标变化
    document.getElementById('finder-target').addEventListener('change', runFinder);
  }

  function updateOwnedUI() {
    document.getElementById('owned-count').textContent = String(ownedSet.size);
    const chipsBox = document.getElementById('finder-selected-chips');
    const ids = Array.from(ownedSet);
    if (ids.length === 0) {
      chipsBox.innerHTML = '<span class="text-muted text-sm">还没选任何帕鲁</span>';
      return;
    }
    chipsBox.innerHTML = `<span class="text-secondary text-sm">已选：</span>` + ids
      .map((id) => {
        const p = palMap.get(id);
        if (!p) return '';
        return `<span class="owned-chip" data-pal-id="${id}">${p.zh} ✕</span>`;
      })
      .join('');
    // 点击 chip 移除
    chipsBox.querySelectorAll('.owned-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.palId;
        ownedSet.delete(id);
        const cell = document.querySelector(`.finder-pal-cell[data-pal-id="${id}"]`);
        if (cell) cell.classList.remove('selected');
        updateOwnedUI();
        runFinder();
      });
    });
  }

  // 多源 BFS：从 ownedSet 全部节点同时出发，找最短路径到 target
  async function findPathFinder(ownedIds, targetId) {
    const data = await getData();
    const target = data.idToIdx.get(targetId);
    if (target === undefined) return null;

    // 起点集合转 idx
    const sources = ownedIds.map((id) => data.idToIdx.get(id)).filter((i) => i !== undefined);
    if (sources.length === 0) return null;
    if (sources.includes(target)) return { sourceIdx: target, path: [target] };

    // 多源 BFS：queue = [node]，visited = Map<node, {parent, source_idx}>
    const visited = new Map();
    const queue = [];
    sources.forEach((s) => {
      visited.set(s, { parent: null, sourceIdx: s });
      queue.push(s);
    });
    let found = null;
    while (queue.length > 0) {
      const node = queue.shift();
      if (node === target) {
        found = visited.get(target);
        break;
      }
      const neighbors = data.adjMap.get(node);
      if (!neighbors) continue;
      for (const next of neighbors) {
        if (visited.has(next)) continue;
        visited.set(next, { parent: node, sourceIdx: visited.get(node).sourceIdx });
        if (next === target) {
          found = visited.get(next);
          break;
        }
        queue.push(next);
      }
      if (found) break;
    }
    if (!found) return null;

    // 重建路径：从 target 回溯到 source
    const path = [];
    let cur = target;
    while (cur !== null) {
      path.push(cur);
      const info = visited.get(cur);
      if (!info || info.parent === null) break;
      cur = info.parent;
    }
    path.reverse();
    return { sourceIdx: found.sourceIdx, path };
  }

  async function runFinder() {
    const out = document.getElementById('finder-result');
    const target = document.getElementById('finder-target').value;

    if (ownedSet.size === 0 && !target) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">勾选你已有的帕鲁 + 选择目标帕鲁，查找最优配种链</p>';
      return;
    }
    if (ownedSet.size === 0) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">请至少勾选一只你已有的帕鲁</p>';
      return;
    }
    if (!target) {
      out.className = 'result-box';
      out.innerHTML = '<p class="text-muted">请选择目标帕鲁</p>';
      return;
    }

    const result = await findPathFinder(Array.from(ownedSet), target);
    if (!result) {
      out.className = 'result-box';
      const data2 = await getData();
      const targetIdx = data2.idToIdx.get(target);
      const targetPal = palMap.get(target);
      // 检查是否是 self-only 帕鲁（只有自身 + 自身 = 自身 配方）
      const producers = data2.reverseMap.get(targetIdx) || [];
      const isSelfOnly = producers.length === 1 && producers[0][0] === targetIdx && producers[0][1] === targetIdx;
      if (isSelfOnly) {
        out.innerHTML = `
          <p class="text-muted">
            <strong>${targetPal?.zh || target}</strong> 是 <strong>${palMap.get(target)?.rarityTier || '稀有'}</strong> 帕鲁，
            游戏中<strong>只能通过野外捕捉 / 击败头目获得</strong>，无法通过配种获得。
          </p>
          <p class="text-secondary mt-2">💡 提示：试试换个非 boss 帕鲁作为目标。</p>
        `;
      } else {
        out.innerHTML = `<p class="text-muted">你拥有的 <strong>${ownedSet.size}</strong> 只帕鲁中无法配出 <strong>${targetPal?.zh || target}</strong>。试试多勾选几只已有帕鲁。</p>`;
      }
      return;
    }

    const { sourceIdx, path } = result;
    const sourcePal = palMap.get(data.pals[sourceIdx].id);
    const targetPal = palMap.get(target);
    const data2 = await getData();

    // 路径可视化
    // path = [p0, p1, p2, ..., pk]
    // 每步：(p_{i-1} + p_i → p_{i+1}) — 但实际边是 p_{i-1} 和某个其他父母 → p_i
    // 简化显示：直接列出所有经过的帕鲁
    const stepsHtml = path
      .map((idx, i) => {
        const p = data2.pals[idx];
        if (!p) return '';
        const arrow = i < path.length - 1 ? '<span class="path-arrow">↓</span>' : '';
        const isStart = idx === sourceIdx;
        const isEnd = i === path.length - 1;
        const tag = isStart ? '<span class="path-tag start">起点</span>' : isEnd ? '<span class="path-tag end">目标</span>' : `<span class="path-tag">第 ${i} 步</span>`;
        return `<div class="path-step">${tag}${palCard(p)}${arrow}</div>`;
      })
      .filter(Boolean)
      .join('');

    const breedingPairsHtml = buildBreedingPairsFromPath(path, data2);

    out.className = 'result-box has-result';
    const totalSteps = path.length - 1;
    out.innerHTML = `
      <p class="mb-2">
        从 <strong>${sourcePal?.zh}</strong> 出发，共 <strong>${totalSteps}</strong> 步配出 <strong>${targetPal?.zh}</strong>：
      </p>
      <div class="path-flow">${stepsHtml}</div>
      ${breedingPairsHtml ? `<div class="breeding-pairs mt-2"><h4>📋 详细配种步骤：</h4>${breedingPairsHtml}</div>` : ''}
    `;
  }

  // 从 BFS 路径反推每一步的"父母 → 后代"
  // path 是 [p0, p1, p2, ...]
  // 第 1 步：p0 + ? → p1   第 2 步：? + p1 → p2  ... 等等
  // 利用 reverseMap 找每个 child 的可能父母对
  function buildBreedingPairsFromPath(path, data) {
    if (path.length < 2) return '';
    const rows = [];
    for (let i = 1; i < path.length; i++) {
      const childIdx = path[i];
      const pairs = data.reverseMap.get(childIdx) || [];
      // 找一对父母，其中至少有一个在前一步可达
      const prevReachable = new Set(path.slice(0, i));  // 0..i-1
      const validPair = pairs.find(([a, b]) => prevReachable.has(a) || prevReachable.has(b));
      if (!validPair) {
        // fallback：找包含 path[i-1] 的 pair
        const prevIdx = path[i - 1];
        const fallback = pairs.find(([a, b]) => a === prevIdx || b === prevIdx);
        if (fallback) {
          rows.push([fallback[0], fallback[1], childIdx]);
          continue;
        }
        // 否则用任意一对
        if (pairs.length > 0) rows.push([pairs[0][0], pairs[0][1], childIdx]);
        continue;
      }
      rows.push([validPair[0], validPair[1], childIdx]);
    }
    const html = rows
      .map(([a, b, c], i) => {
        const pa = data.pals[a];
        const pb = data.pals[b];
        const pc = data.pals[c];
        if (!pa || !pb || !pc) return '';
        return `<div class="bp-row">
          <span class="bp-step">第 ${i + 1} 步</span>
          <span class="bp-parents"><a href="/pals/${pa.id}/">${pa.zh}</a> + <a href="/pals/${pb.id}/">${pb.zh}</a></span>
          <span class="bp-arrow">→</span>
          <span class="bp-child"><a href="/pals/${pc.id}/"><strong>${pc.zh}</strong></a></span>
        </div>`;
      })
      .filter(Boolean)
      .join('');
    return html;
  }

  // 初始化 Path Finder
  initFinder().then(() => updateOwnedUI());

  // 完整配种表（默认过滤同种繁殖）
  async function loadEdgeTable() {
    const data = await getData();
    // 过滤：去掉 X + X = X 的同种繁殖（无实际意义）
    const crossBreedData = data.edgeList.filter((e) => !(e.p1 === e.p2 && e.p1 === e.c));

    // 排序：按父母 A 中文名 → 父母 B 中文名 → 后代
    function sortByPalName(list) {
      return [...list].sort((a, b) => {
        const p1a = palMap.get(a.p1)?.zh || '';
        const p1b = palMap.get(b.p1)?.zh || '';
        if (p1a !== p1b) return p1a.localeCompare(p1b, 'zh');
        const p2a = palMap.get(a.p2)?.zh || '';
        const p2b = palMap.get(b.p2)?.zh || '';
        if (p2a !== p2b) return p2a.localeCompare(p2b, 'zh');
        const ca = palMap.get(a.c)?.zh || '';
        const cb = palMap.get(b.c)?.zh || '';
        return ca.localeCompare(cb, 'zh');
      });
    }

    const tbody = document.getElementById('edge-tbody');
    const MAX_DISPLAY = 100;
    let currentData = crossBreedData;
    let shown = 0;

    function setCount(n) {
      document.getElementById('edge-count').textContent = `共 ${n} 条边`;
    }

    function clearLoadMore() {
      const old = document.getElementById('load-more-row');
      if (old) old.remove();
    }

    function addLoadMore() {
      clearLoadMore();
      const remaining = currentData.length - shown;
      if (remaining > 0) {
        const tr = document.createElement('tr');
        tr.id = 'load-more-row';
        tr.innerHTML = `<td colspan="5" class="text-center"><button id="load-more-btn" class="btn btn-secondary">显示更多（剩余 ${remaining} 条）</button></td>`;
        tbody.appendChild(tr);
        document.getElementById('load-more-btn').addEventListener('click', () => {
          const next = currentData.slice(shown, shown + MAX_DISPLAY);
          renderRows(next);
          shown += next.length;
          if (shown >= currentData.length) {
            clearLoadMore();
          } else {
            const btn = document.getElementById('load-more-btn');
            if (btn) btn.textContent = `显示更多（剩余 ${currentData.length - shown} 条）`;
          }
        });
      }
    }

    function renderRows(rows) {
      const html = rows
        .map((e) => {
          const p1 = palMap.get(e.p1);
          const p2 = palMap.get(e.p2);
          const c = palMap.get(e.c);
          if (!p1 || !p2 || !c) return '';
          return `<tr>
            <td><a href="/pals/${p1.id}/">${p1.zh}</a></td>
            <td class="text-center text-muted">+</td>
            <td><a href="/pals/${p2.id}/">${p2.zh}</a></td>
            <td class="text-center text-muted">→</td>
            <td><a href="/pals/${c.id}/"><strong>${c.zh}</strong></a></td>
          </tr>`;
        })
        .filter(Boolean)
        .join('');
      const t = document.createElement('template');
      t.innerHTML = html;
      while (t.content.firstChild) {
        const loadMore = document.getElementById('load-more-row');
        if (loadMore) tbody.insertBefore(t.content.firstChild, loadMore);
        else tbody.appendChild(t.content.firstChild);
      }
    }

    function render(data) {
      currentData = data;
      tbody.innerHTML = '';
      shown = 0;
      setCount(data.length);
      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">无匹配结果</td></tr>';
        return;
      }
      renderRows(data.slice(0, MAX_DISPLAY));
      shown = Math.min(MAX_DISPLAY, data.length);
      addLoadMore();
    }

    // 初始渲染
    render(sortByPalName(crossBreedData));

    // 搜索
    document.getElementById('edge-search').addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      const filtered = q
        ? crossBreedData.filter((edge) => {
            const p1 = palMap.get(edge.p1);
            const p2 = palMap.get(edge.p2);
            const c = palMap.get(edge.c);
            return (
              (p1 && (p1.zh.toLowerCase().includes(q) || p1.en.toLowerCase().includes(q))) ||
              (p2 && (p2.zh.toLowerCase().includes(q) || p2.en.toLowerCase().includes(q))) ||
              (c && (c.zh.toLowerCase().includes(q) || c.en.toLowerCase().includes(q)))
            );
          })
        : crossBreedData;
      render(sortByPalName(filtered));
    });
  }

  loadEdgeTable();
  init();
</script>


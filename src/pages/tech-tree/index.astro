---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import techsData from '@data/tech.json';
import type { TechNode } from '@data/types';

const techs = techsData as TechNode[];
const structures = techs.filter(t => t.category === 'Structures').length;
const items = techs.filter(t => t.category === 'Items').length;
const maxCost = Math.max(...techs.map(t => t.cost));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Palworld 科技树 - 全部科技点',
  description: 'Palworld 1.0 完整科技树列表。包含所有 Structures（建筑）和 Items（道具）科技点、解锁等级、所需材料。',
  numberOfItems: techs.length,
};

const config = {
  categories: ['Structures', 'Items'] as const,
  maxCost,
};
---

<Layout
  title="科技树 - 全部 587 个科技点 · Palworld 1.0"
  description="Palworld 1.0 完整科技树列表。包含所有 Structures（建筑）和 Items（道具）科技点、解锁等级、所需材料。可按类型、等级筛选，按名称搜索。"
  schema={schema}
>
  <header class="page-header">
    <h1>🔬 科技树</h1>
    <p class="text-secondary">全部 {techs.length} 个科技点 · Structures {structures} · Items {items}</p>
  </header>

  <!-- 搜索 -->
  <div class="filter-bar">
    <input
      type="search"
      id="tech-search"
      class="search-input"
      placeholder="搜索科技点（英文名）..."
      autocomplete="off"
    />

    <div class="filter-row">
      <span class="filter-label">类型</span>
      <div class="filter-chips" data-filter-group="category">
        <button type="button" data-filter-value="" class="chip active">全部</button>
        {config.categories.map((c) => (
          <button type="button" data-filter-value={c} class="chip">{c}</button>
        ))}
      </div>
    </div>

    <div class="filter-row">
      <span class="filter-label">解锁</span>
      <div class="filter-chips" data-filter-group="cost">
        <button type="button" data-filter-value="" class="chip active">全部</button>
        {Array.from({length: maxCost}, (_, i) => i + 1).map((c) => (
          <button type="button" data-filter-value={String(c)} class="chip cost-chip">Lv {c}</button>
        ))}
      </div>
    </div>

    <div class="filter-row">
      <span class="filter-label">排序</span>
      <div class="filter-chips" data-filter-group="sort">
        <button type="button" data-filter-value="" class="chip active">默认</button>
        <button type="button" data-filter-value="level-asc" class="chip">等级 ↑</button>
        <button type="button" data-filter-value="level-desc" class="chip">等级 ↓</button>
        <button type="button" data-filter-value="name-asc" class="chip">A-Z</button>
        <button type="button" data-filter-value="name-desc" class="chip">Z-A</button>
      </div>
    </div>

    <div class="active-filters" id="active-filters" style="display: none;">
      <span class="filter-label">已筛选</span>
      <div id="active-chips"></div>
      <button type="button" id="reset-btn" class="reset-link">清空</button>
    </div>
  </div>

  <!-- 广告位 #1：筛选与卡片网格之间 -->
  <AdSlot position="inline" />

  <!-- 卡片网格 -->
  <div class="tech-grid" id="tech-grid">
    {techs.map((t) => (
      <a
        href={`/tech-tree/${t.slug}/`}
        class="tech-card"
        data-id={t.id}
        data-name={(t.name || '').toLowerCase()}
        data-category={t.category}
        data-cost={String(t.cost)}
      >
        <div class="card-icon">
          <img
            src={t.icon}
            alt={t.name}
            class="card-icon-img"
            loading="lazy"
            decoding="async"
            onerror="this.onerror=null;this.style.visibility='hidden'"
          />
        </div>
        <div class="card-name">{t.name}</div>
        <div class="card-meta">
          <span class="meta-lv">Lv {t.cost}</span>
          <span class="meta-type">{t.category}</span>
        </div>
        <div class="card-cta">点击查看详情 →</div>
      </a>
    ))}
  </div>

  <div class="empty-state" id="empty-state" style="display: none;">
    <p>未找到匹配的科技点</p>
  </div>
</Layout>

<style>
  .page-header { margin-bottom: 1.5rem; }

  .filter-bar {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 1rem;
  }
  .search-input:focus { outline: none; border-color: var(--accent); }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .filter-label {
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    min-width: 48px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .filter-chips { display: flex; gap: 0.375rem; flex-wrap: wrap; }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }
  .chip:hover { border-color: var(--accent); color: var(--text-primary); }
  .chip.active {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
    font-weight: 600;
  }

  .active-filters {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.625rem 0.875rem;
    background: var(--bg-tertiary);
    border-radius: var(--radius);
  }
  /* .active-chip and .reset-link moved to global.css so they apply to JS-generated elements */

  /* 卡片网格 */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .tech-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 0.75rem 0.875rem;
    text-align: center;
    color: inherit;
    text-decoration: none;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
  }
  .tech-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    background: var(--bg-tertiary);
  }
  .tech-card.hidden { display: none; }

  .card-icon {
    width: 104px;
    height: 104px;
    background: var(--bg-tertiary);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .card-icon-img {
    width: 88px;
    height: 88px;
    object-fit: contain;
  }

  .card-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    word-break: break-word;
    line-height: 1.3;
    min-height: 2.6em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-meta {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }
  .meta-lv {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--bg-tertiary);
    color: var(--accent);
    border: 1px solid var(--border);
  }
  .meta-type {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .tech-card[data-category="Structures"] .meta-type {
    background: rgba(94, 179, 245, 0.12);
    color: #5eb3f5;
  }
  .tech-card[data-category="Items"] .meta-type {
    background: rgba(248, 113, 113, 0.12);
    color: #f87171;
  }

  .card-cta {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.125rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
    .card-icon { width: 80px; height: 80px; }
    .card-icon-img { width: 68px; height: 68px; }
  }
</style>

<script is:inline define:vars={{ config }}>
  const state = { category: '', cost: '', sort: '', q: '' };
  const search = document.getElementById('tech-search');
  const grid = document.getElementById('tech-grid');
  const cards = Array.from(document.querySelectorAll('.tech-card'));
  const empty = document.getElementById('empty-state');
  const activeBox = document.getElementById('active-filters');
  const activeChips = document.getElementById('active-chips');
  const resetBtn = document.getElementById('reset-btn');

  function applyFilter() {
    let visible = 0;
    cards.forEach(card => {
      const cat = card.dataset.category;
      const cost = card.dataset.cost;
      const name = card.dataset.name || '';
      let match = true;
      if (state.category && cat !== state.category) match = false;
      if (match && state.cost && cost !== state.cost) match = false;
      if (match && state.q) {
        const q = state.q.toLowerCase();
        if (!name.includes(q) && !cat.toLowerCase().includes(q)) match = false;
      }
      card.classList.toggle('hidden', !match);
      if (match) visible++;
    });
    if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    applySort();
    syncChipState();
    updateActiveChips();
  }

  function applySort() {
    const sortVal = state.sort;
    if (!sortVal) return;
    const sorted = [...cards].sort((a, b) => {
      const costA = Number(a.dataset.cost);
      const costB = Number(b.dataset.cost);
      const nameA = a.dataset.name || '';
      const nameB = b.dataset.name || '';
      switch (sortVal) {
        case 'level-asc':
          if (costA !== costB) return costA - costB;
          return nameA.localeCompare(nameB);
        case 'level-desc':
          if (costA !== costB) return costB - costA;
          return nameA.localeCompare(nameB);
        case 'name-asc':
          return nameA.localeCompare(nameB);
        case 'name-desc':
          return nameB.localeCompare(nameA);
      }
      return 0;
    });
    sorted.forEach(c => grid.appendChild(c));
  }

  function syncChipState() {
    document.querySelectorAll('[data-filter-group]').forEach(g => {
      const key = g.dataset.filterGroup;
      const val = state[key] || '';
      g.querySelectorAll('.chip').forEach(c => {
        const cv = c.dataset.filterValue || '';
        c.classList.toggle('active', cv === val);
      });
    });
  }

  function updateActiveChips() {
    const labels = {
      category: state.category,
      cost: state.cost ? `Lv ${state.cost}` : null,
      sort: ({'level-asc':'等级 ↑','level-desc':'等级 ↓','name-asc':'A-Z','name-desc':'Z-A'})[state.sort] || null,
    };
    const entries = Object.entries(labels).filter(([_, v]) => v);
    if (entries.length === 0) {
      activeBox.style.display = 'none';
      return;
    }
    activeBox.style.display = 'flex';
    activeChips.innerHTML = entries.map(([k, v]) => {
      return `<button type="button" class="active-chip" data-remove-key="${k}">× ${v}</button>`;
    }).join('');
  }

  document.querySelectorAll('[data-filter-group]').forEach(group => {
    group.addEventListener('click', e => {
      const chip = e.target.closest('.chip');
      if (!chip) return;
      const key = group.dataset.filterGroup;
      const val = chip.dataset.filterValue || '';
      state[key] = val;
      applyFilter();
    });
  });

  if (search) {
    search.addEventListener('input', () => {
      state.q = search.value.trim();
      applyFilter();
    });
  }

  if (activeChips) {
    activeChips.addEventListener('click', e => {
      const chip = e.target.closest('.active-chip');
      if (!chip) return;
      const key = chip.dataset.removeKey;
      state[key] = '';
      if (key === 'q' && search) search.value = '';
      applyFilter();
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      state.category = '';
      state.cost = '';
      state.sort = '';
      state.q = '';
      if (search) search.value = '';
      applyFilter();
    });
  }

  applyFilter();
</script>

---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import regionsData from '@data/regions.json';

interface Region {
  name: string;
  raw: string;
  id: string;
  lvMin: number | null;
  lvMax: number | null;
  group: string;
}

const regions = (regionsData as Region[]).slice().sort((a, b) => {
  if (a.group !== b.group) return a.group.localeCompare(b.group);
  return (a.lvMin ?? 0) - (b.lvMin ?? 0);
});

const GROUPS: Record<string, { zh: string; en: string; zhDesc: string; enDesc: string }> = {
  'Palpagos Islands': {
    zh: '初火岛',
    en: 'Palpagos Islands',
    zhDesc: '1.0 之前的主地图区域，从低等级海岸一路延伸到火山、冰原与各座野生动物保护区，绝大部分帕鲁都在这里刷新。',
    enDesc: 'The main pre-1.0 world map, running from the low-level coasts up to the volcano, the snowfields and the wildlife sanctuaries. Most Pals spawn here.',
  },
  'Sakurajima': {
    zh: '樱岛',
    en: 'Sakurajima',
    zhDesc: '樱岛 DLC 主区域，樱花与火山地貌，中高等级帕鲁集中地。',
    enDesc: 'The Sakurajima DLC region - cherry blossoms and volcanic terrain, home to the mid and high level Pals.',
  },
  'Feybreak': {
    zh: '禁猎区',
    en: 'Feybreak',
    zhDesc: '禁猎区 DLC 区域，高等级敌人与地下城集中地，也是 BOSS Bjorn & Bastigor 所在之处。',
    enDesc: 'The Feybreak DLC region - high level enemies and dungeons, and the home of the boss Bjorn & Bastigor.',
  },
  'Sunreach': {
    zh: '云海',
    en: 'Sunreach',
    zhDesc: '1.0 新增的浮空群岛，敌人等级 60-70，核心资源是 Soralite 矿，塔主 Auri & Shaolong 位于 Azure Covenant 之塔。',
    enDesc: 'The floating sky archipelago added in 1.0. Enemy levels 60-70, the core resource is Soralite ore, and the tower boss Auri & Shaolong guards the Azure Covenant tower.',
  },
  'The World Tree': {
    zh: '世界树',
    en: 'The World Tree',
    zhDesc: '1.0 终局区域，敌人等级 70-80，产出 Paloxite、Radiant Gems 与古代文明遗物，最终塔主 Zenara & Astralym 在此。',
    enDesc: 'The 1.0 endgame region. Enemy levels 70-80, and the source of Paloxite, Radiant Gems and Ancient Civilization Relics. The final tower boss Zenara & Astralym waits here.',
  },
  'New Islands': {
    zh: '新岛',
    en: 'New Islands',
    zhDesc: '1.0 新增的小岛群，火山 / 沙漠 / 遗迹三大主题，适合自由探索、刷材料与捕捉帕鲁。',
    enDesc: 'The small islands added in 1.0 - volcano, desert and ruins themes. Good for free exploration, farming materials and catching Pals.',
  },
  'Mount Obsidian': {
    zh: '黑曜火山',
    en: 'Mount Obsidian',
    zhDesc: '初火岛上的火山地带，等级 30-40，是中期装备材料的重要来源。',
    enDesc: 'The volcanic zone on Palpagos, levels 30-40, and an important source of mid-game crafting materials.',
  },
  'Astral Mountains': {
    zh: '星空山脉',
    en: 'Astral Mountains',
    zhDesc: '初火岛北侧的高山冰原，等级 35-50，雷属性与冰属性帕鲁的产地。',
    enDesc: 'The high snowy mountains in the north of Palpagos, levels 35-50, and the home of Electric and Ice Pals.',
  },
  'Twilight Dunes': {
    zh: '黄昏沙丘',
    en: 'Twilight Dunes',
    zhDesc: '沙漠地带，等级 10-25，中期过渡区域。',
    enDesc: 'The desert region, levels 10-25, and a mid-game transition zone.',
  },
};

const groupOrder = [
  'Palpagos Islands', 'Sakurajima', 'Feybreak',
  'Twilight Dunes', 'Mount Obsidian', 'Astral Mountains',
  'New Islands', 'Sunreach', 'The World Tree',
];

const groups = groupOrder
  .map((g) => ({
    key: g,
    meta: GROUPS[g],
    items: regions.filter((r) => r.group === g),
  }))
  .filter((g) => g.items.length > 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Palworld 区域全图鉴 - 80 个区域与等级区间',
  description: 'Palworld 1.0 全部 80 个区域的名称、等级区间与所属大区一览表。',
  numberOfItems: regions.length,
  inLanguage: 'zh-CN',
};
---

<Layout
  title="帕鲁世界区域全图鉴 - 80 个区域与等级区间"
  description="Palworld 1.0 全部 80 个区域的完整清单：初火岛、樱岛、禁猎区、云海 Sunreach、世界树 The World Tree、新岛、黄昏沙丘、黑曜火山、星空山脉，附每个区域的敌人等级区间。"
  schema={schema}
>
  <header class="page-header">
    <p class="breadcrumb"><a href="/">首页</a> › 区域图鉴</p>
    <h1>🗺️ 帕鲁世界区域全图鉴</h1>
    <p class="text-secondary">
      Palworld 1.0 全部 {regions.length} 个区域 · {groups.length} 个大区 · 附每个区域的敌人等级区间
    </p>
  </header>

  <AdSlot position="inline" />

  <section class="intro">
    <p>
      1.0 把世界地图从原来的两块（初火岛 + 樱岛 + 禁猎区）扩展成
      <strong>9 个大区</strong>，其中 <strong>云海 Sunreach</strong> 和
      <strong>世界树 The World Tree</strong> 是全新加入的高等级区域，
      另外还有 <strong>26 个新岛</strong>。
      这个页面按大区整理了全部 {regions.length} 个官方区域名称与对应的敌人等级区间，
      规划刷怪路线、找塔主位置或者判断"这个等级该去哪"时可以对照着看。
    </p>
    <p class="text-secondary">
      注：区域名称沿用游戏内英文原名，中文只标注大区，方便你在游戏地图和第三方资料里对号入座。
    </p>
  </section>

  <AdSlot position="inline" />

  <nav class="group-nav" aria-label="区域大区导航">
    {groups.map((g) => (
      <a href={`#${g.key.replace(/\s+/g, '-').toLowerCase()}`} class="group-chip">{g.meta.zh}</a>
    ))}
  </nav>

  {groups.map((g) => (
    <section class="group" id={g.key.replace(/\s+/g, '-').toLowerCase()}>
      <h2>{g.meta.zh} <span class="group-en">{g.meta.en}</span></h2>
      <p class="group-desc">{g.meta.zhDesc}</p>
      <ul class="region-list">
        {g.items.map((r) => (
          <li class="region-item">
            <span class="region-name">{r.name}</span>
            <span class="region-lv">
              {r.lvMin !== null && r.lvMax !== null
                ? `Lv ${r.lvMin}-${r.lvMax}`
                : r.lvMin !== null
                  ? `Lv ${r.lvMin}`
                  : '—'}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <AdSlot position="inline" />

  <section class="related-links">
    <h2>继续深入</h2>
    <ul>
      <li><a href="/guides/palworld-1-0-guide/">🆕 Palworld 1.0 全内容攻略</a></li>
      <li><a href="/guides/boss-guide/">⚔️ 9 座塔主全打法</a></li>
      <li><a href="/pals/">📖 帕鲁图鉴（按出现区域筛选）</a></li>
      <li><a href="/tech-tree/">🔬 科技树全表（Lv 1-80）</a></li>
      <li><a href="/tier-list/">📊 帕鲁强度排行</a></li>
    </ul>
  </section>
</Layout>

<style>
  .page-header { margin-bottom: 1.5rem; }
  .breadcrumb { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.5rem; }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  h1 { font-size: 2rem; margin: 0.5rem 0; line-height: 1.3; }
  h2 { font-size: 1.5rem; margin: 2.5rem 0 0.75rem; color: var(--accent); border-left: 4px solid var(--accent); padding-left: 0.8rem; }
  .group-en { font-size: 0.8rem; color: var(--text-muted); font-weight: 400; margin-left: 0.5rem; }
  .intro p { line-height: 1.8; margin: 0.8rem 0; }
  .group-desc { color: var(--text-secondary); margin: 0.4rem 0 1rem; line-height: 1.7; }
  .group-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem;
  }
  .group-chip {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .group-chip:hover { background: var(--bg-tertiary); }
  .region-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
  }
  .region-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .region-name { font-size: 0.9rem; }
  .region-lv {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--bg-tertiary);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }
  .related-links { margin-top: 3rem; padding: 1.5rem; background: var(--bg-secondary); border-radius: var(--radius-lg); }
  .related-links ul { list-style: none; padding: 0; }
  .related-links li { padding: 0.3rem 0; }
  .related-links a { color: var(--accent); text-decoration: underline; }
</style>

---
import Layout from '@layouts/Layout.astro';
import PalImage from '@components/PalImage.astro';
import { SITE, PAL_TYPES } from '@/config';
import palsData from '@data/pals.json';
import type { Pal } from '@data/types';

const pals = palsData as Pal[];

// === 计算每个帕鲁的"战力评分"（原创算法） ===
// 公式：HP×1 + ATK×2 + DEF×1.5 + 速度×0.3 + 稀有度等级×50 + 工作适配×5
// 注意：rarity 用 tier 映射 (Common=1, Rare=2, Epic=3, Legendary=4) 保持数值平衡
const TIER_WEIGHT: Record<string, number> = { Common: 1, Rare: 2, Epic: 3, Legendary: 4 };
function powerScore(pal: Pal): number {
  const s = pal.stats;
  const tierWeight = TIER_WEIGHT[pal.rarityTier || 'Common'] || 1;
  return Math.round(
    s.hp * 1 +
    s.attack.melee * 2 +
    s.defense * 1.5 +
    s.speed * 0.3 +
    tierWeight * 50 +
    Object.values(pal.workSuitability || {}).reduce((a, b) => a + (b as number), 0) * 5
  );
}

const palsWithScore = pals
  .filter((p) => p.paldeckNo > 0 && p.paldeckNo < 200)  // 排除变种
  .map((p) => ({ pal: p, score: powerScore(p) }))
  .sort((a, b) => b.score - a.score);

const top10Power = palsWithScore.slice(0, 10);

// === Featured Pal of the Day（每天 1 只轮换） ===
// 用日期 mod 总数取，保证一天一只
const dayIdx = Math.floor(Date.now() / 86400000) % pals.length;
const featuredPal = pals[dayIdx];

// === 真实数据 ===
const totalPals = pals.length;
const breedingEdges = 40972;
const activeSkills = 320;
const passiveSkills = 1905;

// === 1.0 Sakurajima 新增的 17 只 ===
const newPals = pals.filter((p) => p.paldeckNo === 0 || p.paldeckNo > 200).slice(0, 12);

// === 热门配种公式（5 个经典） ===
const popularCombos = [
  { a: 'lamball', b: 'cattiva', c: 'mau' },
  { a: 'anubis', b: 'cattiva', c: 'wixen' },
  { a: 'grizzbolt', b: 'relaxaurus', c: 'orserk' },
  { a: 'mau', b: 'pengullet', c: 'mau-cryst' },
  { a: 'foxparks', b: 'cattiva', c: 'foxparks-cryst' },
];

// === 稀有度分布（按 tier） ===
const rarityDist: Record<string, number> = { Common: 0, Rare: 0, Epic: 0, Legendary: 0 };
pals.forEach((p) => {
  const t = p.rarityTier || 'Common';
  rarityDist[t] = (rarityDist[t] || 0) + 1;
});

// === 属性分布 ===
const typeDist: Record<string, number> = {};
pals.forEach((p) => {
  (p.types || []).forEach((t) => {
    typeDist[t] = (typeDist[t] || 0) + 1;
  });
});

// === 版本时间线 ===
const updates = [
  { ver: 'v1.0', name: 'Sakurajima', date: '2025', newPals: 17, color: '#c084fc' },
  { ver: 'v0.5', name: 'Tides of Terraria', date: '2024-06', newPals: 0, color: '#5eb3f5' },
  { ver: 'v0.3', name: 'Sakurajima Update', date: '2024-03', newPals: 6, color: '#f87171' },
  { ver: 'v0.2', name: 'Area Expansion', date: '2024-01', newPals: 8, color: '#4ade80' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="幻兽帕鲁最全攻略站 - Palworld Guide"
  description={`Palworld 玩家必备攻略站。${totalPals} 只帕鲁图鉴、${breedingEdges} 条配种公式、${activeSkills} 个主动技能、${passiveSkills} 个被动词条。独家战力评分 + 配种链最短路径算法。`}
  schema={schema}
>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="hero-badge">PALWORLD · v1.0 SAKURAJIMA</div>
      <h1 class="hero-title">
        <span class="hero-title-zh">幻兽帕鲁</span>
        <span class="hero-title-accent">最全攻略</span>
      </h1>
      <p class="hero-subtitle">
        {totalPals} 只帕鲁 · {breedingEdges.toLocaleString()} 条配种公式 · {activeSkills} 个技能 · {passiveSkills} 个词条
      </p>
      <div class="hero-cta">
        <a href="/pals/" class="btn btn-primary">📖 浏览图鉴</a>
        <a href="/breeding/" class="btn btn-secondary">🧬 配种计算</a>
        <a href="/pals/?sort=rarity" class="btn btn-secondary">⭐ 稀有度排名</a>
      </div>
    </div>
    <div class="hero-orbit" aria-hidden="true">
      <div class="orbit-pal" style="--rot: 0deg;"><span>🔥</span></div>
      <div class="orbit-pal" style="--rot: 60deg;"><span>💧</span></div>
      <div class="orbit-pal" style="--rot: 120deg;"><span>🌿</span></div>
      <div class="orbit-pal" style="--rot: 180deg;"><span>⚡</span></div>
      <div class="orbit-pal" style="--rot: 240deg;"><span>❄️</span></div>
      <div class="orbit-pal" style="--rot: 300deg;"><span>🌑</span></div>
    </div>
  </section>

  <!-- ===== 实时数据条 ===== -->
  <section class="stat-strip">
    <div class="stat-strip-inner">
      <a href="/pals/" class="stat-cell">
        <div class="stat-num">{totalPals}</div>
        <div class="stat-label">只帕鲁</div>
      </a>
      <div class="stat-divider"></div>
      <a href="/breeding/" class="stat-cell">
        <div class="stat-num">{breedingEdges.toLocaleString()}</div>
        <div class="stat-label">配种公式</div>
      </a>
      <div class="stat-divider"></div>
      <div class="stat-cell">
        <div class="stat-num">{activeSkills}</div>
        <div class="stat-label">主动技能</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-cell">
        <div class="stat-num">{passiveSkills}</div>
        <div class="stat-label">被动词条</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-cell">
        <div class="stat-num">9</div>
        <div class="stat-label">属性种类</div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-cell">
        <div class="stat-num">12</div>
        <div class="stat-label">工作类型</div>
      </div>
    </div>
  </section>

  <!-- ===== Featured Pal of the Day（原创：每日轮换） ===== -->
  <section class="section featured-pal">
    <div class="section-head">
      <div>
        <div class="featured-label">⭐ 今日推荐帕鲁</div>
        <h2>{featuredPal.name.zh}</h2>
        <p class="text-secondary">{featuredPal.name.en} · 编号 #{featuredPal.paldeckNo.toString().padStart(3, '0')}</p>
      </div>
      <a href={`/pals/${featuredPal.id}/`} class="section-link">查看详情 →</a>
    </div>
    <div class="featured-pal-content">
      <div class="featured-pal-img">
        <PalImage pal={featuredPal} size="large" rounded />
      </div>
      <div class="featured-pal-stats">
        <div class="featured-types">
          {featuredPal.types.map((type) => (
            <span class={`type-tag type-${type}`}>{PAL_TYPES.find((t) => t.id === type)?.zh}</span>
          ))}
          <span class={`rarity-tag rarity-${(featuredPal.rarityTier || 'common').toLowerCase()}`}>{featuredPal.rarityTier || 'Common'}</span>
        </div>
        <div class="stat-row">
          <div class="stat-cell-big">
            <div class="stat-num-big">{featuredPal.stats.hp}</div>
            <div class="stat-label-big">HP</div>
          </div>
          <div class="stat-cell-big">
            <div class="stat-num-big">{featuredPal.stats.attack.melee}</div>
            <div class="stat-label-big">近战攻击</div>
          </div>
          <div class="stat-cell-big">
            <div class="stat-num-big">{featuredPal.stats.defense}</div>
            <div class="stat-label-big">防御力</div>
          </div>
          <div class="stat-cell-big">
            <div class="stat-num-big">{featuredPal.stats.speed}</div>
            <div class="stat-label-big">速度</div>
          </div>
        </div>
        <div class="featured-pal-work">
          <div class="work-label">工作适配</div>
          <div class="work-list">
            {Object.entries(featuredPal.workSuitability || {}).map(([w, lvl]) => {
              const ws = PAL_TYPES.find((t) => t.id === w);
              return (
                <div class="work-pill">
                  <span class="work-pill-name">{ws?.zh || w}</span>
                  <span class="work-pill-lvl">Lv {(lvl as number)}</span>
                </div>
              );
            })}
            {Object.keys(featuredPal.workSuitability || {}).length === 0 && (
              <span class="text-muted">无</span>
            )}
          </div>
        </div>
        {featuredPal.drops.length > 0 && (
          <div class="featured-pal-drops">
            <div class="work-label">掉落物</div>
            <div class="drop-list">
              {featuredPal.drops.map((d) => (
                <span class="drop-chip">{d}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ===== 战力排行榜 Top 10（原创算法） ===== -->
  <section class="section">
    <div class="section-head">
      <div>
        <h2>🏆 战力排行榜 Top 10</h2>
        <p class="text-secondary">独家算法：HP + 攻击×2 + 防御×1.5 + 速度×0.3 + 稀有度×50 + 工作适配×5</p>
      </div>
      <a href="/pals/?sort=rarity" class="section-link">完整排名 →</a>
    </div>
    <div class="power-ranking">
      {top10Power.map(({ pal, score }, i) => (
        <a href={`/pals/${pal.id}/`} class="power-row">
          <div class={`power-rank rank-${i + 1}`}>#{i + 1}</div>
          <div class="power-img">
            <PalImage pal={pal} size="small" rounded />
          </div>
          <div class="power-info">
            <div class="power-name">{pal.name.zh}</div>
            <div class="power-name-en">{pal.name.en}</div>
          </div>
          <div class="power-types">
            {pal.types.map((type) => (
              <span class={`type-dot type-${type}`}></span>
            ))}
          </div>
          <div class="power-stats">
            <span title="HP">❤ {pal.stats.hp}</span>
            <span title="攻击">⚔ {pal.stats.attack.melee}</span>
            <span title="防御">🛡 {pal.stats.defense}</span>
          </div>
          <div class="power-score">
            <div class="power-score-num">{score}</div>
            <div class="power-score-label">战力</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== 9 大属性克制 ===== -->
  <section class="section">
    <div class="section-head">
      <h2>🎨 9 大属性克制</h2>
      <p class="text-secondary">点击属性进入对应帕鲁图鉴</p>
    </div>
    <div class="type-grid">
      {PAL_TYPES.map((t) => {
        const count = typeDist[t.id] || 0;
        return (
          <a href={`/pals/?type=${t.id}`} class={`type-card type-${t.id}`}>
            <div class="type-card-name">{t.zh}</div>
            <div class="type-card-en">{t.en}</div>
            <div class="type-card-count">{count} 只</div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ===== 热门帕鲁（基础） ===== -->
  <section class="section">
    <div class="section-head">
      <div>
        <h2>🔥 基础帕鲁一览</h2>
        <p class="text-secondary">所有非变种帕鲁（不含 1.0 新增）</p>
      </div>
      <a href="/pals/?variants=base" class="section-link">仅基础 →</a>
    </div>
    <div class="featured-grid">
      {pals.filter((p) => p.paldeckNo > 0 && p.paldeckNo < 200).slice(0, 12).map((pal) => (
        <a href={`/pals/${pal.id}/`} class="featured-card">
          <div class="featured-img">
            <PalImage pal={pal} size="medium" rounded />
            <div class={`featured-rarity rarity-${(pal.rarityTier || 'common').toLowerCase()}`}>{pal.rarityTier || 'Common'}</div>
          </div>
          <div class="featured-info">
            <div class="featured-name">{pal.name.zh}</div>
            <div class="featured-name-en">{pal.name.en}</div>
            <div class="featured-types">
              {pal.types.map((type) => (
                <span class={`type-dot type-${type}`}></span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== 1.0 Sakurajima 新增 ===== -->
  <section class="section">
    <div class="section-head">
      <div>
        <h2>🆕 1.0 Sakurajima 新增</h2>
        <p class="text-secondary">Sakurajima 更新带来的 17 只全新帕鲁</p>
      </div>
      <a href="/pals/?variants=only" class="section-link">查看全部 →</a>
    </div>
    <div class="new-pals-strip">
      {newPals.map((pal) => (
        <a href={`/pals/${pal.id}/`} class="new-pal-tile">
          <PalImage pal={pal} size="small" rounded />
          <div class="new-pal-name">{pal.name.zh}</div>
          <div class={`new-pal-rarity rarity-${(pal.rarityTier || 'common').toLowerCase()}`}>{pal.rarityTier || 'Common'}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== 热门配种公式 ===== -->
  <section class="section">
    <div class="section-head">
      <div>
        <h2>🧬 热门配种公式</h2>
        <p class="text-secondary">玩家最常问的 5 个配方</p>
      </div>
      <a href="/breeding/" class="section-link">完整配种表 →</a>
    </div>
    <div class="combo-list">
      {popularCombos.map((combo, i) => {
        const a = pals.find((p) => p.id === combo.a);
        const b = pals.find((p) => p.id === combo.b);
        const c = pals.find((p) => p.id === combo.c);
        if (!a || !b || !c) return null;
        return (
          <a href={`/pals/${c.id}/`} class="combo-row">
            <div class="combo-icons">
              <div class="combo-icon"><PalImage pal={a} rounded /></div>
              <span class="combo-op">+</span>
              <div class="combo-icon"><PalImage pal={b} rounded /></div>
              <span class="combo-op">=</span>
              <div class="combo-icon combo-icon-child"><PalImage pal={c} rounded /></div>
            </div>
            <span class="combo-tooltip">{a.name.zh} + {b.name.zh} = {c.name.zh}</span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ===== 工作类型快速入口 ===== -->
  <section class="section">
    <div class="section-head">
      <h2>🛠️ 找特定工作的帕鲁</h2>
    </div>
    <div class="tools-grid">
      <a href="/pals/?work=mining" class="tool-card">
        <div class="tool-icon">⛏️</div>
        <div class="tool-name">采矿队</div>
        <div class="tool-meta">找可采矿帕鲁</div>
      </a>
      <a href="/pals/?work=planting" class="tool-card">
        <div class="tool-icon">🌱</div>
        <div class="tool-name">播种队</div>
        <div class="tool-meta">找可播种帕鲁</div>
      </a>
      <a href="/pals/?work=kindling" class="tool-card">
        <div class="tool-icon">🔥</div>
        <div class="tool-name">生火队</div>
        <div class="tool-meta">找可生火帕鲁</div>
      </a>
      <a href="/pals/?work=cooling" class="tool-card">
        <div class="tool-icon">❄️</div>
        <div class="tool-name">冷藏队</div>
        <div class="tool-meta">找可冷藏帕鲁</div>
      </a>
      <a href="/pals/?work=lumbering" class="tool-card">
        <div class="tool-icon">🪓</div>
        <div class="tool-name">伐木队</div>
        <div class="tool-meta">找可伐木帕鲁</div>
      </a>
      <a href="/pals/?work=handiwork" class="tool-card">
        <div class="tool-icon">🔨</div>
        <div class="tool-name">手工作业</div>
        <div class="tool-meta">找搬运帕鲁</div>
      </a>
    </div>
  </section>

  <!-- ===== 版本时间线（原创） ===== -->
  <section class="section">
    <div class="section-head">
      <h2>📅 Palworld 版本时间线</h2>
    </div>
    <div class="timeline">
      {updates.map((u) => (
        <div class="timeline-item" style={`--c: ${u.color}`}>
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-ver">{u.ver}</div>
            <div class="timeline-name">{u.name}</div>
            <div class="timeline-meta">{u.date} · +{u.newPals} 只帕鲁</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== 稀有度分布（4 档） ===== -->
  <section class="section">
    <div class="section-head">
      <h2>⭐ 稀有度分布</h2>
      <p class="text-secondary">按 in-game 稀有度分级（共 288 只）</p>
    </div>
    <div class="rarity-bar">
      {['Common', 'Rare', 'Epic', 'Legendary'].map((t) => {
        const c = rarityDist[t] || 0;
        if (c === 0) return null;
        const pct = (c / totalPals) * 100;
        const tierKey = t.toLowerCase();
        return (
          <a href={`/pals/?rarity=${t}`} class={`rarity-bar-cell rarity-${tierKey}`} title={`${t} × ${c} 只 (${pct.toFixed(1)}%)`}>
            <div class={`rarity-bar-num rarity-${tierKey}`}>{t}</div>
            <div class="rarity-bar-fill" style={`--pct: ${pct}%`}></div>
            <div class="rarity-bar-count">{c} 只 ({pct.toFixed(0)}%)</div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ===== SEO 文本 ===== -->
  <section class="seo-content">
    <h2>关于 Palworld 攻略站</h2>
    <p>
      <strong>Palworldpedia</strong>（幻兽帕鲁攻略站）收录了 <strong>{totalPals} 只帕鲁</strong> 的完整数据，
      包含 <strong>{breedingEdges.toLocaleString()} 条配种公式</strong>、<strong>{activeSkills} 个主动技能</strong>、
      <strong>{passiveSkills} 个被动词条</strong>。独家功能：<strong>战力评分排行</strong>、<strong>配种链最短路径算法</strong>、<strong>每日推荐帕鲁</strong>。
      所有数据来源于开源社区项目 palcalc 与 beckerfelipee 的 PalworldBreedingCalculator。
    </p>
    <p>
      Palworld（幻兽帕鲁）是由 Pocketpair 开发的开放世界生存制作游戏，自 2024 年 1 月发布以来风靡全球。
      玩家可以捕捉被称为"帕鲁"的神秘生物、建造基地、与帕鲁一起战斗、繁殖稀有帕鲁。
    </p>
  </section>
</Layout>

<style>
  /* === Hero === */
  .hero {
    position: relative;
    padding: 3rem 1rem 2.5rem;
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 20%, rgba(248, 113, 113, 0.15), transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(94, 179, 245, 0.15), transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(251, 191, 36, 0.08), transparent 70%);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(45deg, transparent 48%, var(--border) 49%, var(--border) 51%, transparent 52%),
      linear-gradient(-45deg, transparent 48%, var(--border) 49%, var(--border) 51%, transparent 52%);
    background-size: 60px 60px;
    opacity: 0.15;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-title-zh { color: var(--text-primary); }
  .hero-title-accent {
    background: linear-gradient(135deg, #fbbf24, #f87171, #c084fc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .orbit-pal {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: rotate(var(--rot)) translateX(min(45vw, 350px)) rotate(calc(-1 * var(--rot)));
    font-size: 1.75rem;
    opacity: 0.25;
    animation: orbit-float 8s ease-in-out infinite;
  }

  @keyframes orbit-float {

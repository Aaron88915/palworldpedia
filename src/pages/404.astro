---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
---

<Layout
  title="404 - 页面未找到"
  description="您访问的页面不存在或已被移动。返回 Palworldpedia 首页浏览 288 只帕鲁图鉴，或使用配种计算器快速查找目标帕鲁的配方和最短路径"
  showTopAd={false}
>
  <div class="error-page">
    <div class="error-code">404</div>
    <h1>页面未找到</h1>
    <p class="text-secondary">您访问的页面可能已被移动或不存在。</p>
    <div class="error-cta">
      <a href="/" class="btn">返回首页</a>
      <a href="/pals/" class="btn btn-secondary">浏览帕鲁图鉴</a>
    </div>
  </div>

  <AdSlot position="inline" />
</Layout>

<style>
  .error-page {
    text-align: center;
    padding: 4rem 1rem;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 900;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .error-cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
</style>

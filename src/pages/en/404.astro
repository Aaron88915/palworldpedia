---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import { t } from '@i18n/utils';
---

<Layout
  lang="en"
  title="404 - Page Not Found"
  description="The page you are looking for does not exist"
  showTopAd={false}
>
  <div class="error-page">
    <div class="error-code">404</div>
    <h1>{t('e404.title', 'en')}</h1>
    <p class="text-secondary">{t('e404.desc', 'en')}</p>
    <div class="error-cta">
      <a href="/en/" class="btn">{t('e404.home', 'en')}</a>
      <a href="/en/pals/" class="btn btn-secondary">{t('e404.pals', 'en')}</a>
    </div>
  </div>

  <AdSlot position="inline" />
</Layout>

<style>
  .error-page {
    text-align: center;
    padding: 4rem 1rem;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 900;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .error-cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
</style>

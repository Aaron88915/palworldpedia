---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import { t } from '@i18n/utils';
import techsData from '@data/tech.json';
import type { TechNode } from '@data/types';

const lang = 'en';
const techs = techsData as TechNode[];
const structures = techs.filter(tt => tt.category === 'Structures').length;
const items = techs.filter(tt => tt.category === 'Items').length;
const maxLevel = Math.max(...techs.map(tt => tt.unlockLevel ?? 1));
const levelBuckets = Array.from({ length: Math.ceil(maxLevel / 10) }, (_, i) => {
  const min = i * 10 + 1;
  const max = min + 9;
  return { label: `${min}-${max}`, min, max };
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Palworld Tech Tree - All Tech Points',
  description: 'Complete Palworld 1.0 tech tree. All Structures and Items tech points, unlock levels, and required materials.',
  numberOfItems: techs.length,
  inLanguage: 'en',
};

const config = {
  categories: ['Structures', 'Items'] as const,
  levelBuckets,
  i18n: {
    all: t('common.all', lang),
    unlock: t('tech.unlock', lang),
    default: t('tech.default', lang),
    levelAsc: t('tech.levelAsc', lang),
    levelDesc: t('tech.levelDesc', lang),
    nameAsc: t('tech.nameAsc', lang),
    nameDesc: t('tech.nameDesc', lang),
    clear: t('common.clear', lang),
    active: t('common.active', lang),
    noResult: t('tech.noResult', lang),
  },
};
---

<Layout
  lang={lang}
  title={`${t('tech.title', lang)} - All ${techs.length} Tech Points · Palworld 1.0`}
  description="Complete Palworld 1.0 tech tree. All Structures and Items tech points, unlock levels, and required materials. Filter by type, unlock level, and search by name."
  schema={schema}
>
  <header class="page-header">
    <h1>{t('tech.title', lang)}</h1>
    <p class="text-secondary">{techs.length} {t('tech.totalLabel', lang)} · Structures {structures} · Items {items}</p>
  </header>

  <div class="filter-bar">
    <input
      type="search"
      id="tech-search"
      class="search-input"
      placeholder={t('tech.searchPlaceholder', lang)}
      autocomplete="off"
    />

    <div class="filter-row">
      <span class="filter-label">{t('tech.type', lang)}</span>
      <div class="filter-chips" data-filter-group="category">
        <button type="button" data-filter-value="" class="chip active">{t('common.all', lang)}</button>
        {config.categories.map((c) => (
          <button type="button" data-filter-value={c} class="chip">{c}</button>
        ))}
      </div>
    </div>

    <div class="filter-row">
      <span class="filter-label">{t('tech.unlock', lang)}</span>
      <div class="filter-chips" data-filter-group="level">
        <button type="button" data-filter-value="" class="chip active">{t('common.all', lang)}</button>
        {levelBuckets.map((b) => (
          <button type="button" data-filter-value={b.label} class="chip cost-chip">Lv {b.label}</button>
        ))}
      </div>
    </div>

    <div class="filter-row">
      <span class="filter-label">{t('pals.sort', lang)}</span>
      <div class="filter-chips" data-filter-group="sort">
        <button type="button" data-filter-value="" class="chip active">{t('tech.default', lang)}</button>
        <button type="button" data-filter-value="level-asc" class="chip">{t('tech.levelAsc', lang)}</button>
        <button type="button" data-filter-value="level-desc" class="chip">{t('tech.levelDesc', lang)}</button>
        <button type="button" data-filter-value="name-asc" class="chip">{t('tech.nameAsc', lang)}</button>
        <button type="button" data-filter-value="name-desc" class="chip">{t('tech.nameDesc', lang)}</button>
      </div>
    </div>

    <div class="active-filters" id="active-filters" style="display: none;">
      <span class="filter-label">{t('common.active', lang)}</span>
      <div id="active-chips"></div>
      <button type="button" id="reset-btn" class="reset-link">{t('common.clear', lang)}</button>
    </div>
  </div>

  <AdSlot position="inline" />

  <div class="tech-grid" id="tech-grid">
    {techs.map((tt) => (
      <a
        href={`/en/tech-tree/${tt.slug}/`}
        class="tech-card"
        data-id={tt.id}
        data-name={(tt.name || '').toLowerCase()}
        data-category={tt.category}
        data-level={String(tt.unlockLevel ?? 1)}
      >
        <div class="card-icon">
          <img
            src={tt.icon}
            alt={tt.name}
            class="card-icon-img"
            loading="lazy"
            decoding="async"
            onerror="this.onerror=null;this.style.visibility='hidden'"
          />
        </div>
        <div class="card-name">{tt.name}</div>
        <div class="card-meta">
          <span class="meta-lv">Lv {tt.unlockLevel ?? 1}</span>
          <span class="meta-type">{tt.category}</span>
          <span class="meta-pts">{tt.cost} pts</span>
        </div>
        <div class="card-cta">{t('tech.viewDetail', lang)}</div>
      </a>
    ))}
  </div>

  <div class="empty-state" id="empty-state" style="display: none;">
    <p>{t('tech.noResult', lang)}</p>
  </div>
</Layout>

<style>
  .page-header { margin-bottom: 1.5rem; }
  .filter-bar { margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 1rem;
  }
  .search-input:focus { outline: none; border-color: var(--accent); }
  .filter-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .filter-label { color: var(--text-muted); font-size: 0.8125rem; font-weight: 600; min-width: 48px; text-transform: uppercase; letter-spacing: 0.05em; }
  .filter-chips { display: flex; gap: 0.375rem; flex-wrap: wrap; }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }
  .chip:hover { border-color: var(--accent); color: var(--text-primary); }
  .chip.active { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 600; }

  .active-filters {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.625rem 0.875rem;
    background: var(--bg-tertiary);
    border-radius: var(--radius);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
  }
  .tech-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 0.75rem 0.875rem;
    text-align: center;
    color: inherit;
    text-decoration: none;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
  }
  .tech-card:hover { border-color: var(--accent); transform: translateY(-2px); background: var(--bg-tertiary); }
  .tech-card.hidden { display: none; }

  .card-icon {
    width: 104px;
    height: 104px;
    background: var(--bg-tertiary);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .card-icon-img { width: 88px; height: 88px; object-fit: contain; }
  .card-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    word-break: break-word;
    line-height: 1.3;
    min-height: 2.6em;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-meta { display: flex; gap: 0.375rem; align-items: center; flex-wrap: wrap; justify-content: center; }
  .meta-lv { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; background: var(--bg-tertiary); color: var(--accent); border: 1px solid var(--border); }
  .meta-type { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.6875rem; font-weight: 600; }
  .meta-pts { display: inline-block; font-size: 0.6875rem; font-weight: 600; color: var(--text-muted); }
  .tech-card[data-category="Structures"] .meta-type { background: rgba(94, 179, 245, 0.12); color: #5eb3f5; }
  .tech-card[data-category="Items"] .meta-type { background: rgba(248, 113, 113, 0.12); color: #f87171; }
  .card-cta { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem; }

  .empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-muted); }

  @media (max-width: 480px) {
    .tech-grid { grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
    .card-icon { width: 80px; height: 80px; }
    .card-icon-img { width: 68px; height: 68px; }
  }
</style>

<script is:inline define:vars={{ config }}>
  const state = { category: '', level: '', sort: '', q: '' };
  const search = document.getElementById('tech-search');
  const grid = document.getElementById('tech-grid');
  const cards = Array.from(document.querySelectorAll('.tech-card'));
  const empty = document.getElementById('empty-state');
  const activeBox = document.getElementById('active-filters');
  const activeChips = document.getElementById('active-chips');
  const resetBtn = document.getElementById('reset-btn');

  function applyFilter() {
    let visible = 0;
    cards.forEach(card => {
      const cat = card.dataset.category;
      const level = Number(card.dataset.level || 0);
      const name = card.dataset.name || '';
      let match = true;
      if (state.category && cat !== state.category) match = false;
      if (match && state.level) {
        const [lo, hi] = state.level.split('-').map(Number);
        if (level < lo || level > hi) match = false;
      }
      if (match && state.q) {
        const q = state.q.toLowerCase();
        if (!name.includes(q) && !cat.toLowerCase().includes(q)) match = false;
      }
      card.classList.toggle('hidden', !match);
      if (match) visible++;
    });
    if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    applySort();
    syncChipState();
    updateActiveChips();
  }

  function applySort() {
    const sortVal = state.sort;
    if (!sortVal) return;
    const sorted = [...cards].sort((a, b) => {
      const levelA = Number(a.dataset.level || 0);
      const levelB = Number(b.dataset.level || 0);
      const nameA = a.dataset.name || '';
      const nameB = b.dataset.name || '';
      switch (sortVal) {
        case 'level-asc': if (levelA !== levelB) return levelA - levelB; return nameA.localeCompare(nameB);
        case 'level-desc': if (levelA !== levelB) return levelB - levelA; return nameA.localeCompare(nameB);
        case 'name-asc': return nameA.localeCompare(nameB);
        case 'name-desc': return nameB.localeCompare(nameA);
      }
      return 0;
    });
    sorted.forEach(c => grid.appendChild(c));
  }

  function syncChipState() {
    document.querySelectorAll('[data-filter-group]').forEach(g => {
      const key = g.dataset.filterGroup;
      const val = state[key] || '';
      g.querySelectorAll('.chip').forEach(c => {
        const cv = c.dataset.filterValue || '';
        c.classList.toggle('active', cv === val);
      });
    });
  }

  function updateActiveChips() {
    const labels = {
      category: state.category,
      level: state.level ? `Lv ${state.level}` : null,
      sort: ({'level-asc': config.i18n.levelAsc, 'level-desc': config.i18n.levelDesc, 'name-asc': config.i18n.nameAsc, 'name-desc': config.i18n.nameDesc})[state.sort] || null,
    };
    const entries = Object.entries(labels).filter(([_, v]) => v);
    if (entries.length === 0) {
      activeBox.style.display = 'none';
      return;
    }
    activeBox.style.display = 'flex';
    activeChips.innerHTML = entries.map(([k, v]) => {
      return `<button type="button" class="active-chip" data-remove-key="${k}">× ${v}</button>`;
    }).join('');
  }

  document.querySelectorAll('[data-filter-group]').forEach(group => {
    group.addEventListener('click', e => {
      const chip = e.target.closest('.chip');
      if (!chip) return;
      const key = group.dataset.filterGroup;
      const val = chip.dataset.filterValue || '';
      state[key] = val;
      applyFilter();
    });
  });

  if (search) {
    search.addEventListener('input', () => {
      state.q = search.value.trim();
      applyFilter();
    });
  }

  if (activeChips) {
    activeChips.addEventListener('click', e => {
      const chip = e.target.closest('.active-chip');
      if (!chip) return;
      const key = chip.dataset.removeKey;
      state[key] = '';
      if (key === 'q' && search) search.value = '';
      applyFilter();
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      state.category = '';
      state.level = '';
      state.sort = '';
      state.q = '';
      if (search) search.value = '';
      applyFilter();
    });
  }

  applyFilter();
</script>

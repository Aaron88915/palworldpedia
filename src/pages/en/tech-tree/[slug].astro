---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import { t } from '@i18n/utils';
import techsData from '@data/tech.json';
import type { TechNode } from '@data/types';

const lang = 'en';

export function getStaticPaths() {
  const techs = techsData as TechNode[];
  return techs.map((tt) => ({
    params: { slug: tt.slug },
    props: { tech: tt },
  }));
}

interface Props {
  tech: TechNode;
}
const { tech } = Astro.props;

const allTechs = techsData as TechNode[];
const related = allTechs
  .filter(tt => tt.category === tech.category && tt.slug !== tech.slug)
  .slice(0, 12);

const categoryLabel = tech.category === 'Structures' ? t('tech.categoryStructures', lang) : t('tech.categoryItems', lang);
const hasDetail = !!(tech.description || tech.materials);
---

<Layout
  lang={lang}
  title={`${tech.name} - Unlock Lv ${tech.cost} · ${categoryLabel} | Palworld Tech Tree`}
  description={tech.description || `Palworld ${tech.name} (${categoryLabel}) details: unlock level Lv ${tech.cost}, required materials, stats.`}
>
  <nav class="breadcrumb">
    <a href="/en/tech-tree/">{t('tech.backToTree', lang)}</a>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-cat">{tech.category}</span>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-cur">{tech.name}</span>
  </nav>

  <article class="tech-detail">
    <header class="tech-detail-header">
      <div class="tech-detail-icon-wrap">
        <img src={tech.icon} alt={tech.name} class="tech-detail-icon" />
      </div>
      <div class="tech-detail-titles">
        <h1>{tech.name}</h1>
        <div class="tech-detail-meta">
          <span class={`cat-tag cat-${tech.category.toLowerCase()}`}>{tech.category}</span>
          <span class={`cost-tag cost-${tech.cost}`}>{t('tech.unlockLevel', lang)} {tech.cost}</span>
          {tech.product && tech.product !== tech.name && (
            <span class="product-tag">{t('tech.product', lang)}: {tech.product}</span>
          )}
        </div>
      </div>
    </header>

    <div class="tech-detail-body">
      {tech.description ? (
        <section class="tech-section">
          <h2>{t('tech.description', lang)}</h2>
          <p class="tech-description">{tech.description}</p>
        </section>
      ) : (
        <section class="tech-section tech-section-empty">
          <h2>{t('tech.description', lang)}</h2>
          <p class="text-muted">{t('tech.descriptionMissing', lang)} {tech.category === 'Structures' ? t('tech.structuresDefault', lang) : t('tech.itemsDefault', lang)}.</p>
        </section>
      )}

      {tech.materials && tech.materials.length > 0 && (
        <section class="tech-section">
          <h2>{t('tech.materials', lang)}</h2>
          <div class="mat-grid">
            {tech.materials.map((m) => (
              <div class="mat-item">
                <span class="mat-name">{m.name}</span>
                <span class="mat-count">×{m.count}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      {(tech.hp || tech.defense) && (
        <section class="tech-section">
          <h2>{t('tech.stats', lang)}</h2>
          <div class="stats-grid">
            {tech.hp && (
              <div class="stat-item">
                <span class="stat-label">HP</span>
                <span class="stat-value">{tech.hp.toLocaleString()}</span>
              </div>
            )}
            {tech.defense && (
              <div class="stat-item">
                <span class="stat-label">{t('tech.defense', lang)}</span>
                <span class="stat-value">{tech.defense}</span>
              </div>
            )}
          </div>
        </section>
      )}
    </div>
  </article>

  <AdSlot position="inline" />

  {related.length > 0 && (
    <section class="related-section">
      <h2>{t('tech.related', lang)}</h2>
      <div class="related-grid">
        {related.map((r) => (
          <a href={`/en/tech-tree/${r.slug}/`} class="related-card">
            <img src={r.icon} alt={r.name} class="related-icon" loading="lazy" />
            <span class="related-name">{r.name}</span>
            <span class={`cost-tag cost-${r.cost}`}>Lv {r.cost}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb-sep { color: var(--border); }
  .breadcrumb-cur { color: var(--text-primary); font-weight: 600; }

  .tech-detail {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .tech-detail-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    background: linear-gradient(135deg, var(--bg-secondary), var(--bg-tertiary));
    border-bottom: 1px solid var(--border);
  }

  .tech-detail-icon-wrap {
    width: 100px;
    height: 100px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .tech-detail-icon { width: 80px; height: 80px; object-fit: contain; }

  .tech-detail-titles { flex: 1; }
  .tech-detail-titles h1 { font-size: 1.75rem; margin: 0 0 0.5rem 0; color: var(--text-primary); }
  .tech-detail-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }

  .cat-tag {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .cat-tag.cat-structures { background: rgba(94, 179, 245, 0.15); color: #5eb3f5; }
  .cat-tag.cat-items { background: rgba(248, 113, 113, 0.15); color: #f87171; }

  .cost-tag {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--bg-tertiary);
  }
  .cost-tag.cost-1 { color: #a0a8b0; }
  .cost-tag.cost-2 { color: #4ade80; }
  .cost-tag.cost-3 { color: #5eb3f5; }
  .cost-tag.cost-4 { color: #c084fc; }
  .cost-tag.cost-5, .cost-tag.cost-6, .cost-tag.cost-7, .cost-tag.cost-8, .cost-tag.cost-9 { color: #ffb830; }

  .product-tag {
    padding: 0.25rem 0.625rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .tech-detail-body { padding: 1.5rem 2rem 2rem; }

  .tech-section { margin-bottom: 2rem; }
  .tech-section:last-child { margin-bottom: 0; }
  .tech-section h2 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .tech-description {
    color: var(--text-primary);
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .mat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .mat-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }
  .mat-name { font-weight: 500; }
  .mat-count { color: var(--accent); font-weight: 700; font-size: 0.875rem; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .stat-item {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .stat-label { color: var(--text-muted); font-size: 0.875rem; }
  .stat-value { color: var(--accent); font-weight: 700; font-size: 1.125rem; }

  .related-section { margin-top: 2rem; }
  .related-section h2 { font-size: 1.125rem; margin-bottom: 1rem; color: var(--text-primary); }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.75rem; }
  .related-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem;
    text-align: center;
    color: inherit;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .related-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .related-icon { width: 48px; height: 48px; object-fit: contain; background: var(--bg-tertiary); border-radius: 0.25rem; margin-bottom: 0.5rem; }
  .related-name { display: block; font-size: 0.8125rem; margin-bottom: 0.25rem; word-break: break-word; }

  @media (max-width: 640px) {
    .tech-detail-header { flex-direction: column; text-align: center; gap: 1rem; }
    .tech-detail-titles h1 { font-size: 1.375rem; }
    .tech-detail-body { padding: 1.25rem; }
  }
</style>

---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import PalImage from '@components/PalImage.astro';
import { PAL_TYPES, WORK_SUITABILITIES } from '@/config';
import { t } from '@i18n/utils';
import palsData from '@data/pals.json';
import type { Pal } from '@data/types';

const lang = 'en';

export async function getStaticPaths() {
  const pals = palsData as Pal[];
  return pals.map((pal) => ({
    params: { slug: pal.id },
    props: { pal },
  }));
}

const { pal } = Astro.props as { pal: Pal };

const hpTier = pal.stats.hp >= 150 ? 'S' : pal.stats.hp >= 120 ? 'A' : pal.stats.hp >= 100 ? 'B' : 'C';
const atkTier = pal.stats.attack.melee >= 110 ? 'S' : pal.stats.attack.melee >= 90 ? 'A' : pal.stats.attack.melee >= 70 ? 'B' : 'C';
const defTier = pal.stats.defense >= 110 ? 'S' : pal.stats.defense >= 90 ? 'A' : pal.stats.defense >= 70 ? 'B' : 'C';
const spdTier = pal.stats.speed >= 100 ? 'S' : pal.stats.speed >= 80 ? 'A' : pal.stats.speed >= 60 ? 'B' : 'C';

const palUrl = new URL(`/en/pals/${pal.id}/`, Astro.site).href;
const palImage = new URL(pal.image, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: pal.name.en,
  alternateName: pal.name.zh,
  description: pal.description.en,
  image: palImage,
  genre: 'Open World Survival',
  gamePlatform: 'PC',
  inLanguage: 'en',
  gameItem: {
    '@type': 'Thing',
    name: pal.name.en,
    description: `Pal #${pal.paldeckNo} in the Palworld Paldeck.`,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    ratingCount: '100',
  },
};

const relatedPals = (palsData as Pal[])
  .filter((p) => p.id !== pal.id && p.types.some((tp) => pal.types.includes(tp)))
  .slice(0, 4);
---

<Layout
  lang={lang}
  title={`${pal.name.en} (${pal.name.zh}) - Pal #${pal.paldeckNo} Stats`}
  description={`${pal.name.en} detailed stats: HP ${pal.stats.hp}, ATK ${pal.stats.attack.melee}, DEF ${pal.stats.defense}. Includes skills, passives, habitats, and drops.`}
  image={pal.image}
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/en/">{t('palDetail.breadcrumbHome', lang)}</a>
    <span>›</span>
    <a href="/en/pals/">{t('palDetail.breadcrumbPaldex', lang)}</a>
    <span>›</span>
    <span>{pal.name.en}</span>
  </nav>

  <article class="pal-detail">
    <header class="pal-header">
      <PalImage pal={pal} size="large" rounded />
      <div class="pal-header-info">
        <div class="pal-header-no">#{pal.paldeckNo.toString().padStart(3, '0')}</div>
        <h1 class="pal-header-name">{pal.name.en}</h1>
        <div class="pal-header-name-en">{pal.name.zh}</div>
        <div class="pal-header-types">
          {pal.types.map((type) => {
            const tp = PAL_TYPES.find((x) => x.id === type);
            return <span class={`type-tag type-${type}`}>{tp?.en} · {tp?.zh}</span>;
          })}
        </div>
        <div class="pal-rarity">
          <div class="rarity-bar-detail" data-tier={(pal.rarityTier || 'common').toLowerCase()}>
            <div class="rarity-fill" style={`width: ${(pal.rarity / 20) * 100}%`}></div>
          </div>
          <div class="rarity-meta">
            <span class={`rarity-tag rarity-${(pal.rarityTier || 'common').toLowerCase()}`}>{pal.rarityTier || 'Common'}</span>
            <span class="text-muted">{pal.rarity}/20</span>
          </div>
        </div>
      </div>
    </header>

    <section class="pal-desc">
      <p>{pal.description.en}</p>
    </section>

    <AdSlot position="inline" />

    <section class="pal-section">
      <h2>{t('palDetail.stats', lang)}</h2>
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-label">{t('palDetail.hp', lang)}</div>
          <div class="stat-value">{pal.stats.hp}</div>
          <div class={`stat-tier tier-${hpTier}`}>{hpTier}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">{t('palDetail.meleeAtk', lang)}</div>
          <div class="stat-value">{pal.stats.attack.melee}</div>
          <div class={`stat-tier tier-${atkTier}`}>{atkTier}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">{t('palDetail.rangedAtk', lang)}</div>
          <div class="stat-value">{pal.stats.attack.ranged}</div>
          <div class={`stat-tier tier-${atkTier}`}>{atkTier}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">{t('palDetail.defense', lang)}</div>
          <div class="stat-value">{pal.stats.defense}</div>
          <div class={`stat-tier tier-${defTier}`}>{defTier}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">{t('palDetail.speed', lang)}</div>
          <div class="stat-value">{pal.stats.speed}</div>
          <div class={`stat-tier tier-${spdTier}`}>{spdTier}</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">{t('palDetail.price', lang)}</div>
          <div class="stat-value">{pal.price.toLocaleString()}</div>
          <div class="text-muted stat-tier">{t('palDetail.gold', lang)}</div>
        </div>
      </div>
    </section>

    {Object.keys(pal.workSuitability).length > 0 && (
      <section class="pal-section">
        <h2>{t('palDetail.workSuit', lang)}</h2>
        <div class="work-grid">
          {Object.entries(pal.workSuitability).map(([work, level]) => {
            const w = WORK_SUITABILITIES.find((x) => x.id === work);
            if (!w || !level) return null;
            return (
              <div class="work-card">
                <div class="work-icon">{w.icon}</div>
                <div class="work-name">{w.en}</div>
                <div class="work-level">Lv {level}</div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {pal.skills.length > 0 && (
      <section class="pal-section">
        <h2>{t('palDetail.skills', lang)}</h2>
        <div class="skill-list">
          {pal.skills.map((skill) => (
            <div class="skill-item">
              <div class="skill-header">
                <span class={`skill-type type-${skill.type}`}>{PAL_TYPES.find((tp) => tp.id === skill.type)?.en}</span>
                <span class="skill-name">{skill.name.en}</span>
                <span class="skill-name-en text-muted">{skill.name.zh}</span>
              </div>
              <div class="skill-meta">
                <span>Lv {skill.level}</span>
                <span>{t('palDetail.power', lang)} {skill.power}</span>
                <span>{t('palDetail.cooldown', lang)} {skill.cooldown}s</span>
              </div>
              <p class="skill-desc">{skill.description.en || t('palDetail.skillDescMissing', lang)}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {pal.passives.length > 0 && (
      <section class="pal-section">
        <h2>{t('palDetail.passives', lang)}</h2>
        <div class="passive-list">
          {pal.passives.map((passive) => (
            <div class="passive-item">
              <div class="passive-name">{passive.name.en} · {passive.name.zh}</div>
              <p class="passive-desc">{passive.description.en || t('palDetail.skillDescMissing', lang)}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {pal.drops.length > 0 && (
      <section class="pal-section">
        <h2>{t('palDetail.drops', lang)}</h2>
        <div class="drop-list">
          {pal.drops.map((drop) => (
            <span class="drop-chip">{drop}</span>
          ))}
        </div>
      </section>
    )}

    {(pal.biomes.length > 0 || pal.nightOnly) && (
      <section class="pal-section">
        <h2>{t('palDetail.biomes', lang)}</h2>
        <div class="drop-list">
          {pal.biomes.map((biome) => (
            <span class="drop-chip">{biome}</span>
          ))}
          {pal.nightOnly && <span class="drop-chip">{t('palDetail.nightOnly', lang)}</span>}
        </div>
      </section>
    )}

    <section class="seo-text">
      <h2>{t('palDetail.aboutPal', lang)} {pal.name.en}</h2>
      <p>
        {pal.name.en} ({pal.name.zh}) is Pal #${pal.paldeckNo} in Palworld, a <strong>{pal.types.map((tp) => PAL_TYPES.find((x) => x.id === tp)?.en).join(' / ')}</strong>-type Pal with HP {pal.stats.hp}, ATK {pal.stats.attack.melee}, and DEF {pal.stats.defense}.
      </p>
      <p>
        Best suited for: {Object.keys(pal.workSuitability).map((k) => WORK_SUITABILITIES.find((x) => x.id === k)?.en).join(', ') || 'combat'}.
        Habitats: {pal.biomes.join(', ')}.
        Drops when defeated or caught: {pal.drops.join(', ')}.
      </p>
    </section>

    {relatedPals.length > 0 && (
      <section class="related">
        <h2>{t('palDetail.related', lang)}</h2>
        <div class="related-grid">
          {relatedPals.map((p) => (
            <a href={`/en/pals/${p.id}/`} class="related-card">
              <div class="related-no">#{p.paldeckNo.toString().padStart(3, '0')}</div>
              <div class="related-name">{p.name.en}</div>
              <div class="related-name-en text-muted">{p.name.zh}</div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .breadcrumb a { color: var(--text-secondary); }
  .breadcrumb a:hover { color: var(--accent); }

  .pal-header {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .pal-header { flex-direction: column; text-align: center; }
  }

  .pal-header-no { color: var(--text-muted); font-size: 0.875rem; font-family: var(--font-mono); }
  .pal-header-name { font-size: 2rem; margin: 0.25rem 0; }
  .pal-header-name-en { color: var(--text-muted); margin-bottom: 0.5rem; }
  .pal-header-types { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .type-tag {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    color: #000;
    font-weight: 600;
    font-size: 0.75rem;
  }

  .pal-rarity {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .rarity-bar-detail {
    width: 120px;
    height: 8px;
    background: var(--bg-tertiary);
    border-radius: 4px;
    overflow: hidden;
  }
  .rarity-fill { height: 100%; border-radius: 4px; transition: width 0.3s ease; }
  .rarity-bar-detail[data-tier="common"] .rarity-fill { background: linear-gradient(90deg, #888, #c0c0c0); }
  .rarity-bar-detail[data-tier="rare"] .rarity-fill { background: linear-gradient(90deg, #4a90e2, #5cb0ff); }
  .rarity-bar-detail[data-tier="epic"] .rarity-fill { background: linear-gradient(90deg, #a855f7, #c878ff); }
  .rarity-bar-detail[data-tier="legendary"] .rarity-fill { background: linear-gradient(90deg, #f59e0b, #ffd700); }

  .rarity-meta { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; }
  .rarity-tag {
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .rarity-tag.rarity-common { background: rgba(150,150,150,0.2); color: #c0c0c0; }
  .rarity-tag.rarity-rare { background: rgba(80,170,255,0.2); color: #5cb0ff; }
  .rarity-tag.rarity-epic { background: rgba(180,90,255,0.2); color: #c878ff; }
  .rarity-tag.rarity-legendary { background: rgba(255,180,40,0.2); color: #ffb830; }

  .pal-desc {
    background: var(--bg-secondary);
    border-radius: var(--radius);
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
    border-left: 3px solid var(--accent);
  }

  .pal-section { margin-bottom: 2rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.75rem; }
  .stat-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    text-align: center;
  }
  .stat-label { font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }
  .stat-value { font-size: 1.5rem; font-weight: 700; margin: 0.25rem 0; }
  .stat-tier { font-size: 0.875rem; font-weight: 600; }
  .tier-S { color: #f87171; }
  .tier-A { color: #fbbf24; }
  .tier-B { color: #5eb3f5; }
  .tier-C { color: var(--text-muted); }

  .work-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.5rem; }
  .work-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem;
    text-align: center;
  }
  .work-icon { font-size: 1.5rem; }
  .work-name { font-size: 0.875rem; margin-top: 0.25rem; }
  .work-level { font-size: 0.75rem; color: var(--accent); font-weight: 600; }

  .skill-list, .passive-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .skill-item, .passive-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }
  .skill-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .skill-type {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    color: #000;
    font-size: 0.625rem;
    font-weight: 700;
  }
  .skill-name { font-weight: 600; }
  .skill-name-en { font-size: 0.75rem; }
  .skill-meta { display: flex; gap: 1rem; font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 0.5rem; flex-wrap: wrap; }
  .skill-desc, .passive-desc { color: var(--text-secondary); margin: 0; font-size: 0.875rem; }
  .passive-name { font-weight: 600; margin-bottom: 0.25rem; }

  .drop-list { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .drop-chip {
    padding: 0.375rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .seo-text {
    background: var(--bg-secondary);
    border-radius: var(--radius);
    padding: 1.5rem;
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .seo-text p { color: var(--text-secondary); line-height: 1.7; }

  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.5rem; }
  .related-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem;
    text-align: center;
    color: inherit;
    transition: all 0.15s ease;
  }
  .related-card:hover { border-color: var(--accent); }
  .related-no { font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); }
  .related-name { font-weight: 600; margin-top: 0.25rem; }
</style>

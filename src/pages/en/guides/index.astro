---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import { t } from '@i18n/utils';
const lang = 'en';

const guides = [
  {
    slug: 'palworld-1-0-guide',
    icon: '🆕',
    title: 'Palworld 1.0 Complete Guide',
    desc: 'Level cap 80, Sunreach, the World Tree, 9 tower bosses, Mutation and Awakening explained',
    keywords: 'Palworld 1.0 new content Sunreach world tree mutation awakening',
  },
  {
    slug: 'beginner-guide',
    icon: '🎮',
    title: "Beginner's Guide",
    desc: 'Level 1-10 walkthrough: pick a starter, build a base, breed, first boss fight',
    keywords: 'Palworld beginner guide walkthrough tutorial',
  },
  {
    slug: 'breeding-guide',
    icon: '🧬',
    title: 'Breeding Combos Guide',
    desc: 'Full 287×287 breeding matrix + exclusive recipes + shortest path algorithm',
    keywords: 'Palworld breeding combos calculator recipes',
  },
  {
    slug: 'tech-tree-guide',
    icon: '🔬',
    title: 'Tech Tree Priority',
    desc: '588 techs grouped must-get / recommended / skip. Lv 1-80 optimal route',
    keywords: 'Palworld tech tree priority unlock',
  },
  {
    slug: 'boss-guide',
    icon: '⚔️',
    title: 'All Boss Strategies',
    desc: 'All 9 Tower Bosses including Hard difficulty + field bosses + the 1.0 special bosses',
    keywords: 'Palworld boss strategy tower fight 9 towers',
  },
  {
    slug: 'base-building-guide',
    icon: '🏠',
    title: 'Base Building Guide',
    desc: 'Power calculation, 3-zone layout, production lines, multi-base strategy',
    keywords: 'Palworld base building power production',
  },
];
---

<Layout
  lang={lang}
  title={`${t('guides.title', lang)} - Palworld Guide Hub`}
  description="Palworld English guides hub - 1.0 complete guide, beginner walkthrough, breeding combos, tech tree priority, boss strategies, base building. 6 long-form guides for Palworld players."
>
  <header class="page-header">
    <h1>{t('guides.title', lang)}</h1>
    <p class="text-secondary">1.0 Complete · Beginner · Breeding · Tech Tree · Bosses · Base Building</p>
  </header>

  <AdSlot position="inline" />

  <div class="guides-grid">
    {guides.map(g => (
      <a href={`/en/guides/${g.slug}/`} class="guide-card">
        <div class="guide-icon">{g.icon}</div>
        <h2>{g.title}</h2>
        <p class="guide-desc">{g.desc}</p>
        <span class="guide-keywords">Keywords: {g.keywords}</span>
      </a>
    ))}
  </div>

  <AdSlot position="inline" />

  <section class="tools-section">
    <h2>🔧 Companion Tools</h2>
    <ul class="tools-list">
      <li><a href="/en/pals/">Paldex</a> - detailed stats, habitats, and uses for all 288 Pals</li>
      <li><a href="/en/breeding/">Breeding Calculator</a> - 4 query modes, 40,972 breeding edges</li>
      <li><a href="/en/tech-tree/">Tech Tree</a> - all 588 techs with descriptions, materials and real unlock levels</li>
      <li><a href="/en/regions/">Region Index</a> - all 80 Palworld 1.0 regions with enemy level ranges</li>
      <li><a href="/en/calculator/power/">Power Calculator</a> - select buildings, get power demand</li>
    </ul>
  </section>
</Layout>

<style>
  .page-header { margin-bottom: 1.5rem; }
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .guide-card {
    display: block;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, border-color 0.2s;
  }
  .guide-card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .guide-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .guide-card h2 { font-size: 1.2rem; margin: 0.3rem 0; color: var(--text-primary); }
  .guide-desc { color: var(--text-secondary); font-size: 0.95rem; margin: 0.5rem 0; }
  .guide-keywords { display: block; font-size: 0.8rem; color: var(--text-tertiary, #888); margin-top: 0.5rem; }
  .tools-section { margin-top: 2rem; padding: 1.5rem; background: var(--bg-secondary); border-radius: var(--radius-lg); }
  .tools-section h2 { margin: 0 0 0.8rem; }
  .tools-list { list-style: none; padding: 0; }
  .tools-list li { padding: 0.4rem 0; }
  .tools-list a { color: var(--accent); text-decoration: underline; }
</style>

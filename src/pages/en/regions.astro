---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import regionsData from '@data/regions.json';

interface Region {
  name: string;
  raw: string;
  id: string;
  lvMin: number | null;
  lvMax: number | null;
  group: string;
}

const regions = (regionsData as Region[]).slice().sort((a, b) => {
  if (a.group !== b.group) return a.group.localeCompare(b.group);
  return (a.lvMin ?? 0) - (b.lvMin ?? 0);
});

const GROUPS: Record<string, { en: string; desc: string }> = {
  'Palpagos Islands': {
    en: 'Palpagos Islands',
    desc: 'The main pre-1.0 world map, running from the low-level coasts up to the volcano, the snowfields and the wildlife sanctuaries. Most Pals spawn here.',
  },
  'Sakurajima': {
    en: 'Sakurajima',
    desc: 'The Sakurajima DLC region - cherry blossoms and volcanic terrain, home to the mid and high level Pals.',
  },
  'Feybreak': {
    en: 'Feybreak',
    desc: 'The Feybreak DLC region - high level enemies and dungeons, and the home of the boss Bjorn & Bastigor.',
  },
  'Twilight Dunes': {
    en: 'Twilight Dunes',
    desc: 'The desert region, levels 10-25, and a mid-game transition zone.',
  },
  'Mount Obsidian': {
    en: 'Mount Obsidian',
    desc: 'The volcanic zone on Palpagos, levels 30-40, and an important source of mid-game crafting materials.',
  },
  'Astral Mountains': {
    en: 'Astral Mountains',
    desc: 'The high snowy mountains in the north of Palpagos, levels 35-50, and the home of Electric and Ice Pals.',
  },
  'New Islands': {
    en: 'New Islands',
    desc: 'The small islands added in 1.0 - volcano, desert and ruins themes. Good for free exploration, farming materials and catching Pals.',
  },
  'Sunreach': {
    en: 'Sunreach',
    desc: 'The floating sky archipelago added in 1.0. Enemy levels 60-70, the core resource is Soralite ore, and the tower boss Auri & Shaolong guards the Azure Covenant tower.',
  },
  'The World Tree': {
    en: 'The World Tree',
    desc: 'The 1.0 endgame region. Enemy levels 70-80, and the source of Paloxite, Radiant Gems and Ancient Civilization Relics. The final tower boss Zenara & Astralym waits here.',
  },
};

const groupOrder = [
  'Palpagos Islands', 'Sakurajima', 'Feybreak',
  'Twilight Dunes', 'Mount Obsidian', 'Astral Mountains',
  'New Islands', 'Sunreach', 'The World Tree',
];

const groups = groupOrder
  .map((g) => ({
    key: g,
    meta: GROUPS[g],
    items: regions.filter((r) => r.group === g),
  }))
  .filter((g) => g.items.length > 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Palworld Region Index - All 80 Areas and Level Ranges',
  description: 'Every one of the 80 Palworld 1.0 regions with its enemy level range, grouped by area.',
  numberOfItems: regions.length,
  inLanguage: 'en',
};
---

<Layout
  lang="en"
  title="Palworld Region Index - All 80 Areas and Level Ranges"
  description="Complete list of all 80 Palworld 1.0 regions: Palpagos Islands, Sakurajima, Feybreak, Sunreach, the World Tree, the new islands, Twilight Dunes, Mount Obsidian and the Astral Mountains, with enemy level ranges."
  schema={schema}
>
  <header class="page-header">
    <p class="breadcrumb"><a href="/en/">Home</a> › Regions</p>
    <h1>🗺️ Palworld Region Index</h1>
    <p class="text-secondary">
      All {regions.length} regions in Palworld 1.0 · {groups.length} major areas · with enemy level ranges
    </p>
  </header>

  <AdSlot position="inline" />

  <section class="intro">
    <p>
      1.0 expanded the world map into <strong>{groups.length} major areas</strong>.
      <strong>Sunreach</strong> and <strong>The World Tree</strong> are brand new high-level
      regions, joined by <strong>26 new islands</strong>.
      This page lists every one of the {regions.length} official region names with its enemy
      level range, grouped by area - handy for planning a farming route, locating a tower boss,
      or answering "where do I go at this level".
    </p>
    <p class="text-secondary">
      Region names are the in-game English names, so they match the map and third-party data
      sources exactly.
    </p>
  </section>

  <AdSlot position="inline" />

  <nav class="group-nav" aria-label="Region group navigation">
    {groups.map((g) => (
      <a href={`#${g.key.replace(/\s+/g, '-').toLowerCase()}`} class="group-chip">{g.meta.en}</a>
    ))}
  </nav>

  {groups.map((g) => (
    <section class="group" id={g.key.replace(/\s+/g, '-').toLowerCase()}>
      <h2>{g.meta.en}</h2>
      <p class="group-desc">{g.meta.desc}</p>
      <ul class="region-list">
        {g.items.map((r) => (
          <li class="region-item">
            <span class="region-name">{r.name}</span>
            <span class="region-lv">
              {r.lvMin !== null && r.lvMax !== null
                ? `Lv ${r.lvMin}-${r.lvMax}`
                : r.lvMin !== null
                  ? `Lv ${r.lvMin}`
                  : '—'}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <AdSlot position="inline" />

  <section class="related-links">
    <h2>Keep Exploring</h2>
    <ul>
      <li><a href="/en/guides/palworld-1-0-guide/">🆕 Palworld 1.0 Complete Guide</a></li>
      <li><a href="/en/guides/boss-guide/">⚔️ All 9 tower boss strategies</a></li>
      <li><a href="/en/pals/">📖 Pal Database (filter by habitat)</a></li>
      <li><a href="/en/tech-tree/">🔬 Full tech tree (Lv 1-80)</a></li>
      <li><a href="/en/tier-list/">📊 Pal tier list</a></li>
    </ul>
  </section>
</Layout>

<style>
  .page-header { margin-bottom: 1.5rem; }
  .breadcrumb { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.5rem; }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  h1 { font-size: 2rem; margin: 0.5rem 0; line-height: 1.3; }
  h2 { font-size: 1.5rem; margin: 2.5rem 0 0.75rem; color: var(--accent); border-left: 4px solid var(--accent); padding-left: 0.8rem; }
  .intro p { line-height: 1.8; margin: 0.8rem 0; }
  .group-desc { color: var(--text-secondary); margin: 0.4rem 0 1rem; line-height: 1.7; }
  .group-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem;
  }
  .group-chip {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .group-chip:hover { background: var(--bg-tertiary); }
  .region-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
  }
  .region-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .region-name { font-size: 0.9rem; }
  .region-lv {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--bg-tertiary);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }
  .related-links { margin-top: 3rem; padding: 1.5rem; background: var(--bg-secondary); border-radius: var(--radius-lg); }
  .related-links ul { list-style: none; padding: 0; }
  .related-links li { padding: 0.3rem 0; }
  .related-links a { color: var(--accent); text-decoration: underline; }
</style>
